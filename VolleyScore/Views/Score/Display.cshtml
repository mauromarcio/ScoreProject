@* File: VolleyScore/Views/Score/Display.cshtml *@
@* Purpose: Part 2 – Big-screen score display. Opens on a separate monitor/computer.
            Connects to SignalR and updates in real time when operator changes score.
            Team sides are INVERTED vs court view – from the audience the teams face the
            opposite direction to how they appear on the operator's court screen. *@
@model VolleyScore.ViewModels.ScoreDisplayViewModel
@{
    ViewData["Title"] = Model.MatchReference + " – Display";
    Layout = "_LayoutDisplay";

    // Invert left/right vs court: the team on the left of the court appears on the
    // right of the display (audience perspective is the mirror of the operator's view)
    var leftTeamName  = !Model.HomeTeamOnLeft ? Model.HomeTeamName  : Model.AwayTeamName;
    var rightTeamName = !Model.HomeTeamOnLeft ? Model.AwayTeamName  : Model.HomeTeamName;
    var leftScore     = !Model.HomeTeamOnLeft ? Model.HomeScore     : Model.AwayScore;
    var rightScore    = !Model.HomeTeamOnLeft ? Model.AwayScore     : Model.HomeScore;
    var leftSetsWon   = !Model.HomeTeamOnLeft ? Model.HomeSetsWon   : Model.AwaySetsWon;
    var rightSetsWon  = !Model.HomeTeamOnLeft ? Model.AwaySetsWon   : Model.HomeSetsWon;
    var leftIsServing = !Model.HomeTeamOnLeft ? Model.HomeIsServing : !Model.HomeIsServing;
    int setsToShow    = (Model.TotalSets / 2) + 1;
}

@section Styles {
<style>
    /* Full-screen dark scoreboard */
    body.display-screen {
        background: #0d0d0d;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    .display-wrapper {
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 20px;
        gap: 12px;
    }

    /* Match header */
    .display-header {
        text-align: center;
        color: #aaa;
        font-size: 1.1rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        flex-shrink: 0;
    }

    .display-header .match-ref {
        color: #fff;
        font-size: 1.4rem;
    }

    /* Main score row */
    .display-score-row {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        gap: 0;
        min-height: 0;
    }

    /* Team block – both sides use same structure */
    .display-team {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-width: 0;
    }

    .display-team-name {
        font-size: clamp(2.5rem, 6vw, 5.5rem);
        font-weight: 900;
        color: #ffffff;
        text-align: center;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        line-height: 1.1;
        padding: 0 20px;
        word-break: break-word;
    }

    /* Score number */
    .display-score-number {
        font-size: var(--score-font-size, 24vw);
        font-weight: 900;
        color: #ffe033;
        font-family: 'Courier New', Courier, monospace;
        line-height: 0.9;
        text-shadow:
            0 0 60px rgba(255, 224, 51, 0.5),
            0 4px 20px rgba(0,0,0,0.8);
        transition: transform 0.15s ease;
        min-width: 1ch;
        text-align: center;
    }

    .display-score-number.score-flash {
        transform: scale(1.08);
        color: #fff;
    }

    /* Divider / net */
    .display-divider {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 24px;
        flex-shrink: 0;
    }

    .display-colon {
        font-size: clamp(5rem, 14vw, 12rem);
        font-weight: 900;
        color: #444;
        line-height: 1;
        font-family: 'Courier New', Courier, monospace;
    }

    /* Serving indicator */
    .display-serving {
        font-size: 0.9rem;
        font-weight: 700;
        color: #43a047;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 4px 16px;
        border: 2px solid #43a047;
        border-radius: 20px;
        background: rgba(67, 160, 71, 0.1);
        transition: opacity 0.3s ease;
    }

    .display-serving.hidden { opacity: 0; }

    /* Bottom row: set dots + sets won score */
    .display-bottom-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        flex-shrink: 0;
        padding-bottom: 8px;
    }

    .display-set-dots {
        display: flex;
        gap: 12px;
    }

    .display-set-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 3px solid #444;
        background: transparent;
        transition: background 0.3s ease, border-color 0.3s ease;
    }

    .display-set-dot.won {
        background: #ffe033;
        border-color: #ffe033;
        box-shadow: 0 0 12px rgba(255, 224, 51, 0.6);
    }

    .display-sets-score {
        font-size: clamp(1.5rem, 4vw, 3rem);
        font-weight: 700;
        color: #ccc;
        white-space: nowrap;
    }

    .display-sets-score .sets-left,
    .display-sets-score .sets-right {
        color: #ffe033;
    }

    /* Font size controls – appear on hover/touch, fade after 15 s */
    .size-controls {
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 20px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
        z-index: 200;
    }

    .size-controls.visible {
        opacity: 1;
        pointer-events: auto;
    }

    .size-btn {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        border: 3px solid #ffe033;
        background: rgba(0, 0, 0, 0.85);
        color: #ffe033;
        font-size: 2.8rem;
        font-weight: 900;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
        user-select: none;
        padding: 0;
    }

    .size-btn:active {
        background: rgba(255, 224, 51, 0.15);
    }

    /* Connection status indicator */
    .connection-status {
        position: fixed;
        top: 12px;
        right: 16px;
        font-size: 0.75rem;
        color: #444;
        display: flex;
        align-items: center;
        gap: 6px;
        z-index: 100;
    }

    .conn-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #888;
        transition: background 0.3s;
    }

    .conn-dot.connected { background: #4caf50; }
    .conn-dot.disconnected { background: #f44336; }
</style>
}

<div class="display-wrapper">

    <!-- Header -->
    <div class="display-header">
        <div class="match-ref">@Model.MatchReference</div>
        <div id="displaySetInfo">Set <span id="displaySetNumber">@Model.CurrentSetNumber</span></div>
    </div>

    <!-- Main score area -->
    <div class="display-score-row">

        <!-- Left team -->
        <div class="display-team" id="displayLeftTeam">
            <div class="display-team-name" id="displayLeftTeamName">@leftTeamName</div>
            <div class="display-serving @(leftIsServing ? "" : "hidden")"
                 id="displayLeftServing">SERVING</div>
            <div class="display-score-number" id="displayLeftScore">@leftScore</div>
        </div>

        <!-- Divider -->
        <div class="display-divider">
            <div class="display-colon">:</div>
        </div>

        <!-- Right team -->
        <div class="display-team" id="displayRightTeam">
            <div class="display-team-name" id="displayRightTeamName">@rightTeamName</div>
            <div class="display-serving @(!leftIsServing ? "" : "hidden")"
                 id="displayRightServing">SERVING</div>
            <div class="display-score-number" id="displayRightScore">@rightScore</div>
        </div>
    </div>

    <!-- Bottom: set dots and sets won -->
    <div class="display-bottom-row">
        <div class="display-set-dots" id="displayLeftDots">
            @for (int i = 0; i < setsToShow; i++)
            {
                <div class="display-set-dot @(i < leftSetsWon ? "won" : "")"
                     data-index="@i"></div>
            }
        </div>
        <div class="display-sets-score">
            <span class="sets-left" id="displayLeftSets">@leftSetsWon</span>
            <span style="color:#444"> – </span>
            <span class="sets-right" id="displayRightSets">@rightSetsWon</span>
        </div>
        <div class="display-set-dots" id="displayRightDots">
            @for (int i = 0; i < setsToShow; i++)
            {
                <div class="display-set-dot @(i < rightSetsWon ? "won" : "")"
                     data-index="@i"></div>
            }
        </div>
    </div>

</div>

<!-- Font size controls (appear on hover/touch, auto-hide after 15 s) -->
<div class="size-controls" id="sizeControls">
    <button class="size-btn" id="sizeMinus">−</button>
    <button class="size-btn" id="sizePlus">+</button>
</div>

<!-- Real-time connection status dot -->
<div class="connection-status">
    <div class="conn-dot" id="connDot"></div>
    <span id="connText"></span>
</div>

@section Scripts {
<script>
    // Pass server-rendered initial state to the display JS
    // homeTeamOnLeft is NEGATED here so the JS tracks display-side (inverted from court)
    var DISPLAY_DATA = {
        matchId: @Model.MatchId,
        homeTeamName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HomeTeamName)),
        awayTeamName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AwayTeamName)),
        homeScore: @Model.HomeScore,
        awayScore: @Model.AwayScore,
        homeSetsWon: @Model.HomeSetsWon,
        awaySetsWon: @Model.AwaySetsWon,
        currentSetNumber: @Model.CurrentSetNumber,
        totalSets: @Model.TotalSets,
        homeIsServing: @Model.HomeIsServing.ToString().ToLower(),
        homeTeamOnLeft: @((!Model.HomeTeamOnLeft).ToString().ToLower())
    };
</script>
<script src="~/js/display.js" asp-append-version="true"></script>
}
