@* File: VolleyScore/Views/Teams/TraditionalLineups.cshtml *@
@model IEnumerable<VolleyScore.Models.Tournament>
@using VolleyScore.Models
@{
    ViewData["Title"] = "Traditional Line-up Sheets";

    // Flatten all enrolled teams across tournaments into a single ordered list
    var allPairs = new List<(Tournament Tournament, Team Team)>();
    foreach (var t in Model)
    {
        foreach (var tt in t.TournamentTeams.Where(x => x.Team != null).OrderBy(x => x.SeedPosition))
            allPairs.Add((t, tt.Team!));
    }
}

@section Styles {
<style>
/* ── Screen toolbar ──────────────────────────────────────────────── */
.toolbar { display:flex; align-items:center; gap:12px; padding:12px 0 16px; }

/* ── Page sheet — 2 team blocks per sheet ────────────────────────── */
.sheet-page {
    width: 190mm;
    margin: 0 auto 20px;
    padding: 6mm 7mm;
    box-sizing: border-box;
    border: 1px solid #bbb;
    background: #fff;
    font-family: Arial, Helvetica, sans-serif;
    color: #111;
    page-break-after: always;
}
.sheet-page:last-child { page-break-after: auto; }

/* Dashed divider between 2 teams on same sheet */
.team-divider {
    border: none;
    border-top: 1.5px dashed #aaa;
    margin: 5mm 0;
}

/* ── Per-team block ──────────────────────────────────────────────── */
.team-block { /* no explicit height — content drives it */ }

/* Title */
.block-title {
    text-align: center;
    font-size: 13pt;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
    margin-bottom: 2mm;
    line-height: 1.2;
}
.title-accent { color: #0d9488; }

/* Info row */
.info-row {
    display: flex;
    align-items: flex-end;
    gap: 6mm;
    padding: 1.5mm 0;
    border-top: 1.5px solid #333;
    border-bottom: 1px solid #ccc;
    margin-bottom: 3mm;
    font-size: 7pt;
    font-weight: 700;
    letter-spacing: .04em;
    white-space: nowrap;
}
.info-field { display:flex; align-items:center; gap:4px; }

/* Main body — roster left, sets right */
.main-body { display:flex; gap:4mm; align-items:flex-start; }

/* ── Roster table ────────────────────────────────────────────────── */
.roster-col { flex:0 0 42%; }
.roster-table {
    width:100%;
    border-collapse:collapse;
    font-size:7.5pt;
}
.roster-table th, .roster-table td {
    border:1px solid #666;
    padding:0 5px;
    height:6.5mm;
    line-height:1;
    vertical-align:middle;
}
.roster-span-header {
    text-align:center;
    background:#b2e5e5;
    font-weight:700;
    font-size:7pt;
    letter-spacing:.08em;
    text-transform:uppercase;
}
.roster-col-header {
    text-align:center;
    background:#5cc8c8;
    font-weight:700;
    font-size:7pt;
    letter-spacing:.04em;
    text-transform:uppercase;
}
.num-cell { text-align:center; width:11mm; }

/* ── Set diagrams ────────────────────────────────────────────────── */
.sets-col { flex:1; display:flex; flex-direction:column; gap:0; }

.set-block { border:1.5px solid #555; }

/* Set header row */
.set-header-row {
    display:flex;
    align-items:center;
    border-bottom:1px solid #555;
    background:#f0fafa;
}
.set-icon-cell { padding:1px 4px; display:flex; align-items:center; }
.set-icon-cell svg { width:14px; height:14px; }
.set-label {
    flex:1;
    text-align:center;
    font-size:8pt;
    font-weight:800;
    letter-spacing:.06em;
    text-transform:uppercase;
    padding:2px 0;
}
.libero-cell {
    display:flex;
    align-items:center;
    gap:2px;
    border-left:1px solid #555;
    padding:2px 4px;
    font-size:6pt;
    font-weight:700;
    letter-spacing:.03em;
    white-space:nowrap;
}
.libero-line { display:inline-block; min-width:12mm; border-bottom:1px solid #444; height:4mm; }

/* Team name row */
.set-team-row {
    display:flex;
    align-items:flex-end;
    padding:1px 5px;
    font-size:6.5pt;
    font-weight:700;
    border-bottom:1px solid #ccc;
    gap:3px;
    height:6mm;
}
.set-team-line { flex:1; border-bottom:1px solid #444; }

/* 3×2 court position grid */
.court-grid {
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    grid-template-rows:repeat(2, 9mm);
    border-bottom:1px solid #ccc;
}
.court-cell {
    border:1px solid #ccc;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:flex-start;
    padding:1px 3px;
    font-size:7pt;
    font-weight:700;
    color:#444;
    position:relative;
    min-height:9mm;
}
.server-label {
    position:absolute;
    bottom:1px;
    right:3px;
    font-size:5.5pt;
    color:#999;
    font-style:italic;
    font-weight:400;
}

/* Coach signature */
.set-sig-row {
    display:flex;
    align-items:flex-end;
    padding:1px 5px;
    font-size:6pt;
    font-weight:700;
    letter-spacing:.03em;
    gap:3px;
    height:6mm;
}
.set-sig-line { flex:1; border-bottom:1px solid #444; }

/* Separator between SET 1 and SET 2 */
.set-separator { border-top:1.5px dashed #999; margin:2.5mm 0; }

/* ── Volleyball ball SVG (inline, tiny) ─────────────────────────── */

@@media print {
    nav, .toolbar, .no-print { display:none !important; }
    @@page { margin:5mm; size:letter portrait; }
    body { background:#fff !important; }
    .sheet-page { border:none; margin:0; padding:4mm 5mm; width:100%; }
}
</style>
}

<!-- Toolbar -->
<div class="container no-print">
    <div class="toolbar">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <h2 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Traditional Line-up Sheets</h2>
        <button class="btn btn-outline-secondary btn-sm ms-auto" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

@if (!allPairs.Any())
{
    <div class="container" style="text-align:center;padding:40px;color:#666">
        <i class="bi bi-journal-text" style="font-size:2rem;display:block;margin-bottom:8px"></i>
        No active tournaments with enrolled teams found.
    </div>
}
else
{
    @* Render 2 team blocks per physical sheet *@
    @for (int pi = 0; pi * 2 < allPairs.Count; pi++)
    {
        var p1 = allPairs[pi * 2];
        bool hasP2 = pi * 2 + 1 < allPairs.Count;
        var p2 = hasP2 ? allPairs[pi * 2 + 1] : default;

        <div class="sheet-page">

            @* ── Team 1 block ── *@
            @{ RenderBlock(p1.Tournament, p1.Team); }

            @if (hasP2)
            {
                <hr class="team-divider" />
                @{ RenderBlock(p2.Tournament, p2.Team); }
            }

        </div>
    }
}

@* ── Local helper — renders one team's lineup block ─────────────── *@
@functions {
    void RenderBlock(VolleyScore.Models.Tournament tournament, VolleyScore.Models.Team team)
    {
        var players = team.Players.OrderBy(p => p.Number).Take(6).ToList();

        <div class="team-block">

            <div class="block-title">
                @tournament.Name &nbsp;<span class="title-accent">LINE-UP</span>&nbsp; SHEET
            </div>

            <div class="info-row">
                <div class="info-field">TEAM:&nbsp;<strong>@team.Name</strong></div>
            </div>

            <div class="main-body">

                <!-- Roster -->
                <div class="roster-col">
                    <table class="roster-table">
                        <thead>
                            <tr><th colspan="2" class="roster-span-header">PLAYER ROSTER</th></tr>
                            <tr>
                                <th class="num-cell roster-col-header">#</th>
                                <th class="roster-col-header">PLAYER NAME</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int row = 0; row < 8; row++)
                            {
                                var player = row < players.Count ? players[row] : null;
                                <tr>
                                    <td class="num-cell">@(player != null ? player.Number.ToString() : "")</td>
                                    <td>@(player?.Name ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Set diagrams -->
                <div class="sets-col">

                    <div class="set-block">
                        <div class="set-header-row">
                            <div class="set-icon-cell">
                                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <!-- volleyball: ball + three curved panel seams -->
                                    <circle cx="10" cy="10" r="8.5" fill="#e6f7f6" stroke="#0d9488" stroke-width="1.4"/>
                                    <path d="M1.8,8 C5,2.5 15,2.5 18.2,8" stroke="#0d9488" stroke-width="1.1" fill="none"/>
                                    <path d="M1.8,8 C3,14.5 6.5,18.5 10,19" stroke="#0d9488" stroke-width="1.1" fill="none"/>
                                    <path d="M18.2,8 C17,14.5 13.5,18.5 10,19" stroke="#0d9488" stroke-width="1.1" fill="none"/>
                                </svg>
                            </div>
                            <div class="set-label">SET 1</div>
                            <div class="libero-cell">LIBERO&nbsp;NO.&nbsp;<span class="libero-line"></span></div>
                        </div>
                        <div class="set-team-row">TEAM<span class="set-team-line"></span></div>
                        <div class="court-grid">
                            <div class="court-cell">IV</div>
                            <div class="court-cell">III</div>
                            <div class="court-cell">II</div>
                            <div class="court-cell">V</div>
                            <div class="court-cell">VI</div>
                            <div class="court-cell">I<span class="server-label">Server</span></div>
                        </div>
                        <div class="set-sig-row">COACH SIGNATURE<span class="set-sig-line"></span></div>
                    </div>

                    <div class="set-separator"></div>

                    <div class="set-block">
                        <div class="set-header-row">
                            <div class="set-icon-cell">
                                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="10" cy="10" r="8.5" fill="#e6f7f6" stroke="#0d9488" stroke-width="1.4"/>
                                    <path d="M1.8,8 C5,2.5 15,2.5 18.2,8" stroke="#0d9488" stroke-width="1.1" fill="none"/>
                                    <path d="M1.8,8 C3,14.5 6.5,18.5 10,19" stroke="#0d9488" stroke-width="1.1" fill="none"/>
                                    <path d="M18.2,8 C17,14.5 13.5,18.5 10,19" stroke="#0d9488" stroke-width="1.1" fill="none"/>
                                </svg>
                            </div>
                            <div class="set-label">SET 2</div>
                            <div class="libero-cell">LIBERO&nbsp;NO.&nbsp;<span class="libero-line"></span></div>
                        </div>
                        <div class="set-team-row">TEAM<span class="set-team-line"></span></div>
                        <div class="court-grid">
                            <div class="court-cell">IV</div>
                            <div class="court-cell">III</div>
                            <div class="court-cell">II</div>
                            <div class="court-cell">V</div>
                            <div class="court-cell">VI</div>
                            <div class="court-cell">I<span class="server-label">Server</span></div>
                        </div>
                        <div class="set-sig-row">COACH SIGNATURE<span class="set-sig-line"></span></div>
                    </div>

                </div><!-- /.sets-col -->

            </div><!-- /.main-body -->

        </div><!-- /.team-block -->
    }
}
