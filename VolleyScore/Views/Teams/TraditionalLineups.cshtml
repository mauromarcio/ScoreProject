@* File: VolleyScore/Views/Teams/TraditionalLineups.cshtml *@
@model IEnumerable<VolleyScore.Models.Tournament>
@using VolleyScore.Models
@{
    ViewData["Title"] = "Traditional Line-up Sheets";
    var tournaments = Model.ToList();
}

@section Styles {
<style>
/* ── Screen toolbar ─────────────────────────────────────────────────────── */
.toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0 16px;
}

/* ── Sheet wrapper ──────────────────────────────────────────────────────── */
.sheet-page {
    width: 185mm;
    min-height: 257mm;
    margin: 0 auto 24px;
    padding: 7mm 8mm;
    box-sizing: border-box;
    border: 1px solid #bbb;
    background: #fff;
    font-family: Arial, Helvetica, sans-serif;
    color: #111;
    page-break-after: always;
}
.sheet-page:last-child { page-break-after: auto; }

/* ── Title ──────────────────────────────────────────────────────────────── */
.sheet-title {
    text-align: center;
    font-size: 20pt;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
    margin-bottom: 2mm;
    line-height: 1.1;
}
.title-accent { color: #0d9488; }

/* ── Info row ───────────────────────────────────────────────────────────── */
.info-row {
    display: flex;
    align-items: center;
    gap: 10mm;
    padding: 2mm 0;
    border-top: 1.5px solid #333;
    border-bottom: 1px solid #ccc;
    margin-bottom: 4mm;
    font-size: 8pt;
    font-weight: 600;
    letter-spacing: .04em;
}
.info-field { display: flex; align-items: flex-end; gap: 3px; white-space: nowrap; }
.info-line {
    display: inline-block;
    min-width: 40mm;
    border-bottom: 1px solid #444;
    height: 5mm;
}
.check-row { display: flex; align-items: center; gap: 5px; }
.check-box {
    width: 10px; height: 10px;
    border: 1.5px solid #444;
    display: inline-block;
    vertical-align: middle;
    margin-right: 2px;
}

/* ── Main body ──────────────────────────────────────────────────────────── */
.main-body {
    display: flex;
    gap: 5mm;
    align-items: flex-start;
}

/* ── Roster column ──────────────────────────────────────────────────────── */
.roster-col { flex: 0 0 43%; }

.roster-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5pt;
}
.roster-table th,
.roster-table td {
    border: 1px solid #666;
    padding: 3.5px 6px;
    height: 7mm;
}
.roster-span-header {
    text-align: center;
    background: #b2e5e5;
    font-weight: 700;
    font-size: 8pt;
    letter-spacing: .08em;
    text-transform: uppercase;
}
.roster-col-header {
    text-align: center;
    background: #5cc8c8;
    font-weight: 700;
    font-size: 8pt;
    letter-spacing: .04em;
    text-transform: uppercase;
}
.roster-col-header.name-header { text-align: center; }
.num-cell { text-align: center; width: 12mm; }

/* ── Sets column ────────────────────────────────────────────────────────── */
.sets-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
}

.set-block {
    border: 1.5px solid #555;
}

/* Set header */
.set-header-row {
    display: flex;
    align-items: center;
    border-bottom: 1px solid #555;
}
.set-icon-cell {
    padding: 2px 5px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.set-icon-cell img,
.set-icon-cell svg { width: 18px; height: 18px; }
.set-label {
    flex: 1;
    text-align: center;
    font-size: 9.5pt;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: 3px 0;
}
.libero-cell {
    display: flex;
    align-items: center;
    gap: 3px;
    border-left: 1px solid #555;
    padding: 2px 5px;
    font-size: 6.5pt;
    font-weight: 700;
    letter-spacing: .04em;
    white-space: nowrap;
}
.libero-line {
    display: inline-block;
    min-width: 14mm;
    border-bottom: 1px solid #444;
    height: 4.5mm;
}

/* Team row */
.set-team-row {
    display: flex;
    align-items: flex-end;
    padding: 2px 6px;
    font-size: 7.5pt;
    font-weight: 700;
    border-bottom: 1px solid #bbb;
    gap: 3px;
}
.set-team-line { flex: 1; border-bottom: 1px solid #444; height: 5mm; }

/* Court grid — 3 cols × 2 rows */
.court-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 22mm);
    border-bottom: 1px solid #bbb;
}
.court-cell {
    border: 1px solid #bbb;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 2px 4px;
    font-size: 8pt;
    font-weight: 700;
    color: #444;
    position: relative;
    min-height: 22mm;
}
.server-label {
    position: absolute;
    bottom: 3px;
    right: 4px;
    font-size: 6pt;
    color: #888;
    font-style: italic;
    font-weight: 400;
}

/* Coach signature */
.set-sig-row {
    display: flex;
    align-items: flex-end;
    padding: 3px 6px;
    font-size: 7pt;
    font-weight: 700;
    letter-spacing: .04em;
    gap: 4px;
}
.set-sig-line { flex: 1; border-bottom: 1px solid #444; height: 5mm; }

/* Dashed separator between sets */
.set-separator {
    border-top: 1.5px dashed #999;
    margin: 3mm 0;
}

/* Empty section message */
.no-tournaments {
    text-align: center;
    color: #666;
    padding: 40px;
    font-size: 11pt;
}

@@media print {
    nav, .toolbar, .no-print { display: none !important; }
    @@page { margin: 6mm; size: letter portrait; }
    body { background: #fff !important; }
    .sheet-page {
        border: none;
        margin: 0;
        padding: 4mm 5mm;
        width: 100%;
        min-height: auto;
    }
}
</style>
}

<!-- Toolbar (hidden on print) -->
<div class="container no-print">
    <div class="toolbar">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Traditional Line-up Sheets</h2>
        <button class="btn btn-outline-secondary btn-sm ms-auto" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

@if (!tournaments.Any() || !tournaments.Any(t => t.TournamentTeams.Any()))
{
    <div class="no-tournaments">
        <i class="bi bi-journal-text" style="font-size:2rem;display:block;margin-bottom:8px"></i>
        No active tournaments with enrolled teams found.
    </div>
}
else
{
    @foreach (var tournament in tournaments)
    {
        var teams = tournament.TournamentTeams
            .Where(tt => tt.Team != null)
            .OrderBy(tt => tt.SeedPosition)
            .Select(tt => tt.Team!)
            .ToList();

        @foreach (var team in teams)
        {
            var players = team.Players.OrderBy(p => p.Number).Take(6).ToList();

            <!-- One page per team -->
            <div class="sheet-page">

                <!-- Title -->
                <div class="sheet-title">
                    @tournament.Name &nbsp;<span class="title-accent">LINE-UP</span>&nbsp; SHEET
                </div>

                <!-- Info row -->
                <div class="info-row">
                    <div class="info-field">TEAM:&nbsp;<span class="info-line"></span></div>
                    <div class="info-field">DATE:&nbsp;<span class="info-line" style="min-width:30mm"></span></div>
                    <div class="info-field check-row">
                        CHECK ONE:
                        <span class="check-box"></span>HOME
                        &nbsp;
                        <span class="check-box"></span>VISITOR
                    </div>
                </div>

                <!-- Main body -->
                <div class="main-body">

                    <!-- Left: Player Roster -->
                    <div class="roster-col">
                        <table class="roster-table">
                            <thead>
                                <tr>
                                    <th colspan="2" class="roster-span-header">PLAYER ROSTER</th>
                                </tr>
                                <tr>
                                    <th class="num-cell roster-col-header">#</th>
                                    <th class="roster-col-header name-header">PLAYER NAME</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int row = 0; row < 8; row++)
                                {
                                    var player = row < players.Count ? players[row] : null;
                                    <tr>
                                        <td class="num-cell">@(player != null ? player.Number.ToString() : "")</td>
                                        <td>@(player?.Name ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Right: Set diagrams -->
                    <div class="sets-col">

                        <!-- SET 1 -->
                        <div class="set-block">
                            <div class="set-header-row">
                                <div class="set-icon-cell">
                                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <circle cx="10" cy="10" r="9" stroke="#0d9488" stroke-width="2"/>
                                        <path d="M10 1a9 9 0 0 1 0 18" stroke="#0d9488" stroke-width="1.5" fill="none"/>
                                        <path d="M5 4.5C7 7 7 13 5 15.5" stroke="#0d9488" stroke-width="1.2" fill="none"/>
                                    </svg>
                                </div>
                                <div class="set-label">SET 1</div>
                                <div class="libero-cell">LIBERO&nbsp;NO.&nbsp;<span class="libero-line"></span></div>
                            </div>
                            <div class="set-team-row">TEAM<span class="set-team-line"></span></div>
                            <div class="court-grid">
                                <div class="court-cell">IV</div>
                                <div class="court-cell">III</div>
                                <div class="court-cell">II</div>
                                <div class="court-cell">V</div>
                                <div class="court-cell">VI</div>
                                <div class="court-cell">I<span class="server-label">Server</span></div>
                            </div>
                            <div class="set-sig-row">COACH SIGNATURE<span class="set-sig-line"></span></div>
                        </div>

                        <div class="set-separator"></div>

                        <!-- SET 2 -->
                        <div class="set-block">
                            <div class="set-header-row">
                                <div class="set-icon-cell">
                                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <circle cx="10" cy="10" r="9" stroke="#0d9488" stroke-width="2"/>
                                        <path d="M10 1a9 9 0 0 1 0 18" stroke="#0d9488" stroke-width="1.5" fill="none"/>
                                        <path d="M5 4.5C7 7 7 13 5 15.5" stroke="#0d9488" stroke-width="1.2" fill="none"/>
                                    </svg>
                                </div>
                                <div class="set-label">SET 2</div>
                                <div class="libero-cell">LIBERO&nbsp;NO.&nbsp;<span class="libero-line"></span></div>
                            </div>
                            <div class="set-team-row">TEAM<span class="set-team-line"></span></div>
                            <div class="court-grid">
                                <div class="court-cell">IV</div>
                                <div class="court-cell">III</div>
                                <div class="court-cell">II</div>
                                <div class="court-cell">V</div>
                                <div class="court-cell">VI</div>
                                <div class="court-cell">I<span class="server-label">Server</span></div>
                            </div>
                            <div class="set-sig-row">COACH SIGNATURE<span class="set-sig-line"></span></div>
                        </div>

                    </div><!-- /.sets-col -->

                </div><!-- /.main-body -->

            </div><!-- /.sheet-page -->
        }
    }
}
