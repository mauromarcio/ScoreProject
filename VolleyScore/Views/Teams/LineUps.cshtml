@* File: VolleyScore/Views/Teams/LineUps.cshtml *@
@model IEnumerable<VolleyScore.Models.Team>
@{
    ViewData["Title"] = "Team Line-ups";
    var teamList = Model.ToList();
}

@section Styles {
    <style>
        .lineup-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .lineup-card {
            border: 1.5px dashed #aaa;
            padding: 12px 14px;
        }
        .lineup-card-title {
            font-size: 1.05rem;
            font-weight: 700;
            padding: 6px 10px;
            margin-bottom: 8px;
            border-radius: 4px;
        }
        .lineup-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .9rem;
        }
        .lineup-table th,
        .lineup-table td {
            border: 1px solid #999;
            padding: 7px 8px;
        }
        .lineup-table th {
            background: #f0f0f0;
            font-weight: 600;
            text-align: center;
        }
        .lineup-table td.pos-cell { text-align: center; width: 55px; }
        .lineup-table td.num-cell { text-align: center; width: 44px; }

        @@media print {
            nav, .no-print { display: none !important; }
            @@page { margin: 8mm; size: A4 portrait; }
            body { font-size: 10pt; }

            .lineup-grid {
                gap: 6px;
            }
            .lineup-card {
                break-inside: avoid;
                page-break-inside: avoid;
                border: 1.5px dashed #888;
                padding: 8px 10px;
            }
            .lineup-card-title { font-size: 10.5pt; }
            .lineup-table { font-size: 9pt; }
            .lineup-table th, .lineup-table td { padding: 6px 6px; }
        }
    </style>
}

<div class="container-fluid py-4">

    <div class="d-flex align-items-center justify-content-between mb-4 no-print">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="mb-0"><i class="bi bi-layout-text-window me-2"></i>Team Line-ups</h2>
        </div>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>

    <div class="lineup-grid">
        @foreach (var team in teamList)
        {
            var players = team.Players.OrderBy(p => p.Number).ToList();
            int slots = players.Count > 4 ? 6 : 4;

            <div class="lineup-card">
                <div class="lineup-card-title" data-team-name="@team.Name">@team.Name</div>
                <table class="lineup-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Player Name</th>
                            <th>Pos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int slot = 1; slot <= slots; slot++)
                        {
                            var player = slot <= players.Count ? players[slot - 1] : null;
                            <tr>
                                <td class="num-cell">@(player != null ? player.Number.ToString() : "")</td>
                                <td>@(player?.Name ?? "")</td>
                                <td class="pos-cell"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@section Scripts {
<script>
    var EMOJI_COLORS = {
        '🟢': { bg: '#4caf50', dark: false },
        '🟡': { bg: '#ffeb3b', dark: false },
        '🔵': { bg: '#2196f3', dark: true  },
        '⚪': { bg: '#e0e0e0', dark: false },
        '⚫': { bg: '#424242', dark: true  },
        '🟤': { bg: '#8b5e3c', dark: true  },
        '🔴': { bg: '#e53935', dark: true  },
        '🟠': { bg: '#fb8c00', dark: false },
        '🟣': { bg: '#8e24aa', dark: true  },
        '🩵': { bg: '#64b5f6', dark: false },
    };
    var KEYWORD_COLORS = [
        { keyword: 'baby blue', bg: '#90caf9', dark: false },
    ];

    document.querySelectorAll('[data-team-name]').forEach(function (el) {
        var name  = el.getAttribute('data-team-name') || '';
        var first = Array.from(name)[0];
        if (!first) return;
        var entry = EMOJI_COLORS[first];
        if (entry) {
            el.style.backgroundColor = entry.bg;
            el.style.color = entry.dark ? '#fff' : '#000';
            return;
        }
        var lower = name.toLowerCase();
        for (var i = 0; i < KEYWORD_COLORS.length; i++) {
            if (lower.indexOf(KEYWORD_COLORS[i].keyword) !== -1) {
                el.style.backgroundColor = KEYWORD_COLORS[i].bg;
                el.style.color = KEYWORD_COLORS[i].dark ? '#fff' : '#000';
                break;
            }
        }
    });
</script>
}
