@* File: VolleyScore/Views/Teams/Index.cshtml *@
@model IEnumerable<VolleyScore.Models.Team>
@{
    ViewData["Title"] = "Teams";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-people me-2 text-primary"></i>Teams</h2>
        <a asp-action="Create" class="btn btn-primary ms-auto">
            <i class="bi bi-plus-circle me-1"></i> New Team
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-people" style="font-size:2rem"></i>
                <p class="mt-2">No teams registered yet.</p>
                <a asp-action="Create" class="btn btn-primary">Create First Team</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var team in Model)
            {
                var rotationCount = team.Rotations?.Count ?? 0;
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@team.Name</h5>
                            @if (!string.IsNullOrEmpty(team.Description))
                            {
                                <p class="card-text text-muted small">@team.Description</p>
                            }
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>@team.Players.Count player(s)
                                </small>
                                @if (rotationCount > 0)
                                {
                                    <small class="text-success ms-2">
                                        <i class="bi bi-arrow-repeat me-1"></i>@rotationCount/6 rotation saved
                                    </small>
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent d-flex gap-2 flex-wrap">
                            <a asp-controller="Players" asp-action="Index" asp-route-teamId="@team.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-person-badge me-1"></i>Players
                            </a>
                            <a asp-action="Rotation" asp-route-id="@team.Id"
                               class="btn btn-sm @(rotationCount == 6 ? "btn-success" : "btn-outline-info")"
                               title="Set initial court rotation">
                                <i class="bi bi-arrow-repeat me-1"></i>Rotation
                            </a>
                            <a asp-action="Edit" asp-route-id="@team.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@team.Id"
                               class="btn btn-sm btn-outline-danger ms-auto">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
