@* File: VolleyScore/Views/Shared/Error.cshtml *@
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center" style="max-width:600px">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size:3rem"></i>
    <h2 class="mt-3">An Error Occurred</h2>
    <p class="text-muted">Something went wrong. Please try again or contact support.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go Home</a>
</div>
