@* File: VolleyScore/Views/Shared/_LayoutLive.cshtml *@
@* Purpose: Minimal mobile-first layout for the public live score display — no admin navigation. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-deep: #0f172a;
            --bg-card: rgba(255,255,255,0.06);
            --bg-card-hover: rgba(255,255,255,0.10);
            --border-card: rgba(255,255,255,0.12);
            --text-primary: #f1f5f9;
            --text-muted: #94a3b8;
            --accent-green: #22c55e;
            --accent-blue: #3b82f6;
            --accent-amber: #f59e0b;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%);
            min-height: 100vh;
            color: var(--text-primary);
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .live-header {
            background: rgba(15,23,42,0.95);
            border-bottom: 1px solid var(--border-card);
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }
        .live-header-title {
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-primary);
        }
        .live-header-sub {
            font-size: 0.72rem;
            color: var(--text-muted);
            margin-top: 1px;
        }
        .live-page { padding: 12px 12px 32px; max-width: 600px; margin: 0 auto; }

        /* ── Section headers ───────────────────────────────────── */
        .section-label {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 20px 0 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border-card);
        }

        /* ── Cards ─────────────────────────────────────────────── */
        .glass-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 10px;
        }
        .glass-card-sm {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 10px;
            padding: 10px 14px;
            margin-bottom: 8px;
        }

        /* ── Live match card ───────────────────────────────────── */
        .live-pulse {
            display: inline-block;
            width: 8px; height: 8px;
            background: var(--accent-green);
            border-radius: 50%;
            animation: pulse 1.4s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }
        .live-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(34,197,94,0.15);
            border: 1px solid rgba(34,197,94,0.35);
            color: var(--accent-green);
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 2px 8px;
            border-radius: 20px;
        }
        .match-teams {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-top: 10px;
        }
        .team-block {
            flex: 1;
            min-width: 0;
        }
        .team-block.right { text-align: right; }
        .team-link {
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .team-link:hover { color: var(--accent-blue); }
        .score-block {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex-shrink: 0;
        }
        .score-num {
            font-size: 2.4rem;
            font-weight: 900;
            line-height: 1;
            color: #fff;
            min-width: 48px;
            text-align: center;
        }
        .score-sep {
            font-size: 1.6rem;
            font-weight: 300;
            color: var(--text-muted);
        }
        .match-meta {
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.72rem;
            color: var(--text-muted);
        }
        .serving-dot {
            display: inline-block;
            width: 7px; height: 7px;
            background: var(--accent-amber);
            border-radius: 50%;
            margin-right: 4px;
        }

        /* ── Standings table ────────────────────────────────────── */
        .standings-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
        }
        .standings-table th {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.68rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 6px 6px 4px;
            border-bottom: 1px solid var(--border-card);
        }
        .standings-table td {
            padding: 7px 6px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-variant-numeric: tabular-nums;
        }
        .standings-table tr:last-child td { border-bottom: none; }
        .standings-table tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
        .rank-num { color: var(--text-muted); font-weight: 600; }
        .td-num { text-align: right; color: var(--text-muted); }
        .td-num-highlight { text-align: right; color: var(--text-primary); font-weight: 700; }

        /* ── Result rows ────────────────────────────────────────── */
        .result-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-size: 0.85rem;
        }
        .result-row:last-child { border-bottom: none; }
        .result-team { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .result-team.winner { font-weight: 700; color: var(--text-primary); }
        .result-team.loser { color: var(--text-muted); }
        .result-score {
            font-variant-numeric: tabular-nums;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-primary);
            white-space: nowrap;
            padding: 2px 10px;
            background: rgba(255,255,255,0.08);
            border-radius: 6px;
        }
        .empty-state {
            text-align: center;
            color: var(--text-muted);
            padding: 24px 0;
            font-size: 0.85rem;
        }

        /* ── Back button ────────────────────────────────────────── */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--accent-blue);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
        }
        .back-btn:hover { color: #93c5fd; }

        /* ── Pool name badge ────────────────────────────────────── */
        .pool-name-badge {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: var(--accent-blue);
            margin-bottom: 6px;
        }
        .tournament-name-badge {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--accent-amber);
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
