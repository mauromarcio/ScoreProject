@* File: VolleyScore/Views/Tournaments/Details.cshtml *@
@model VolleyScore.Models.Tournament
@{
    ViewData["Title"] = Model.Name;
    var teams = Model.TournamentTeams.OrderBy(tt => tt.SeedOrder).ToList();
    int numCourts = Math.Max(1, Model.NumberOfCourts);

    // Full round-robin: every team plays every other team exactly once
    int n = teams.Count;
    int expectedMatches = n * (n - 1) / 2;
}

<div class="container py-4" style="max-width:720px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-fill">
            <h2 class="mb-0">@Model.Name</h2>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted mb-0 small">@Model.Description</p>
            }
        </div>
        <span class="badge fs-6 @(Model.Status == TournamentStatus.Completed ? "bg-dark" : Model.Status == TournamentStatus.Playoffs ? "bg-warning text-dark" : Model.Status == TournamentStatus.PoolPlay ? "bg-success" : "bg-secondary")">
            @Model.Status
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-3">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-primary">@teams.Count</div>
                    <div class="small text-muted">Teams</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-info">@numCourts</div>
                    <div class="small text-muted">Court@(numCourts > 1 ? "s" : "")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-success">@Model.PoolSetsPerMatch</div>
                    <div class="small text-muted">Sets / Pool Match</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card text-center">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-warning">@Model.PlayoffSetsPerMatch</div>
                    <div class="small text-muted">Sets / Playoff</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status == TournamentStatus.Setup && numCourts > 1)
    {
        <div class="alert alert-info small mb-4">
            <i class="bi bi-info-circle me-1"></i>
            <strong>@numCourts courts</strong> configured.
            All @n teams will play each other — <strong>@expectedMatches matches</strong> total.
            Matches will be distributed evenly across courts so games can run in parallel,
            reducing total tournament time without affecting standings.
        </div>
    }

    <!-- Teams with drag-to-reorder -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Teams – Pool Order</strong>
            <span class="text-muted small">Drag to reorder seeding</span>
        </div>
        <ul class="list-group list-group-flush" id="teamSortList">
            @foreach (var tt in teams)
            {
                <li class="list-group-item d-flex align-items-center gap-3 sortable-item"
                    data-team-id="@tt.TeamId">
                    <i class="bi bi-grip-vertical text-muted" style="cursor:grab"></i>
                    <span class="badge bg-secondary seed-badge">@tt.SeedOrder</span>
                    <span class="fw-semibold">@tt.Team?.Name</span>
                </li>
            }
        </ul>
        <div class="card-footer" id="reorderStatus" style="display:none">
            <span class="text-success small"><i class="bi bi-check-circle me-1"></i>Order saved</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex flex-wrap gap-2">
        @if (Model.Status == TournamentStatus.Setup)
        {
            <form asp-action="GeneratePoolMatches" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('Generate @expectedMatches pool match@(expectedMatches != 1 ? "es" : "") across @numCourts court@(numCourts > 1 ? "s" : "")?')">
                    <i class="bi bi-play-fill me-1"></i> Generate Pool Matches
                </button>
            </form>
        }
        @if (Model.Status == TournamentStatus.PoolPlay || Model.Status == TournamentStatus.Playoffs)
        {
            <a asp-action="PoolPlay" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-table me-1"></i> Pool Play &amp; Standings
            </a>
        }
        @if (Model.Status == TournamentStatus.PoolPlay)
        {
            <form asp-action="GeneratePlayoffs" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-warning"
                        onclick="return confirm('Generate semi-final matches from current standings?')">
                    <i class="bi bi-diagram-3 me-1"></i> Generate Semi-finals
                </button>
            </form>
        }
        @if (Model.Status == TournamentStatus.Playoffs || Model.Status == TournamentStatus.Completed)
        {
            <a asp-action="Bracket" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="bi bi-diagram-3 me-1"></i> View Bracket
            </a>
        }
        <a asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i> All Matches
        </a>
        <a asp-action="Report" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-file-earmark-text me-1"></i> Report
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="ms-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm"
                    onclick="return confirm('Delete this tournament and all its matches?')">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    var tournamentId = @Model.Id;
    var sortList     = document.getElementById('teamSortList');
    var statusEl     = document.getElementById('reorderStatus');
    var saveTimer    = null;

    Sortable.create(sortList, {
        animation: 150,
        handle: '.bi-grip-vertical',
        onEnd: function () {
            sortList.querySelectorAll('.sortable-item').forEach(function(el, idx) {
                el.querySelector('.seed-badge').textContent = idx + 1;
            });
            clearTimeout(saveTimer);
            saveTimer = setTimeout(saveOrder, 600);
        }
    });

    function saveOrder() {
        var ids = Array.from(sortList.querySelectorAll('.sortable-item'))
            .map(function(el) { return parseInt(el.dataset.teamId); });

        fetch('/Tournaments/ReorderTeams', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tournamentId: tournamentId, teamIds: ids })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                statusEl.style.display = '';
                setTimeout(function() { statusEl.style.display = 'none'; }, 2000);
            }
        });
    }
</script>
}
