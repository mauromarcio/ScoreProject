@* File: VolleyScore/Views/Tournaments/Index.cshtml *@
@model IEnumerable<VolleyScore.Models.Tournament>
@{
    ViewData["Title"] = "Tournaments";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">Tournaments</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Tournament
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-trophy" style="font-size:3rem"></i>
            <p class="mt-3">No tournaments yet. Create your first tournament to get started.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var t in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@t.Name</h5>
                                <span class="badge @(t.Status == TournamentStatus.Completed ? "bg-dark" : t.Status == TournamentStatus.Playoffs ? "bg-warning text-dark" : t.Status == TournamentStatus.PoolPlay ? "bg-success" : "bg-secondary")">
                                    @t.Status
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <p class="card-text text-muted small">@t.Description</p>
                            }
                            <p class="card-text small">
                                <i class="bi bi-people me-1"></i> @t.TournamentTeams.Count team(s)
                                &nbsp;|&nbsp; Created @t.CreatedAt.ToString("MMM d, yyyy")
                            </p>
                        </div>
                        <div class="card-footer d-flex gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-info-circle me-1"></i> Details
                            </a>
                            @if (t.Status == TournamentStatus.PoolPlay || t.Status == TournamentStatus.Setup)
                            {
                                <a asp-action="PoolPlay" asp-route-id="@t.Id" class="btn btn-sm btn-outline-success flex-fill">
                                    <i class="bi bi-table me-1"></i> Pool Play
                                </a>
                            }
                            @if (t.Status == TournamentStatus.Playoffs || t.Status == TournamentStatus.Completed)
                            {
                                <a asp-action="Bracket" asp-route-id="@t.Id" class="btn btn-sm btn-outline-warning flex-fill">
                                    <i class="bi bi-diagram-3 me-1"></i> Bracket
                                </a>
                            }
                            <a asp-action="LiveBracket" asp-route-id="@t.Id" class="btn btn-sm btn-outline-info flex-fill" target="_blank">
                                <i class="bi bi-display me-1"></i> Live View
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
