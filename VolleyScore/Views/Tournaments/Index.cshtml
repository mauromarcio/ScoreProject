@* File: VolleyScore/Views/Tournaments/Index.cshtml *@
@model IEnumerable<VolleyScore.Models.Tournament>
@using VolleyScore.Models
@{
    ViewData["Title"] = "Tournaments";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Tournaments</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Tournament
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-diagram-3" style="font-size:3rem;opacity:.3"></i>
            <p class="mt-3">No tournaments yet. Create one to get started.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var t in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="card-title mb-0">@t.Name</h5>
                                    @if (t.TournamentType == TournamentType.Doubles)
                                    {
                                        <span class="badge bg-teal text-white small mt-1" style="background:#0d9488">
                                            <i class="bi bi-person-arms-up me-1"></i>Doubles
                                        </span>
                                    }
                                </div>
                                <span class="badge @(t.Status == TournamentStatus.Completed ? "bg-success" :
                                                     t.Status == TournamentStatus.Knockouts ? "bg-warning text-dark" :
                                                     t.Status == TournamentStatus.PoolStage ? "bg-info text-dark" :
                                                     "bg-secondary")">
                                    @t.Status
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <p class="card-text small text-muted">@t.Description</p>
                            }
                            <div class="small text-muted mt-2">
                                <i class="bi bi-people me-1"></i>@t.TournamentTeams.Count teams enrolled
                                &nbsp;|&nbsp;
                                <i class="bi bi-collection me-1"></i>@t.SetsPerMatch sets/match
                                @if (t.InitialScore > 0)
                                {
                                    <span>&nbsp;|&nbsp;<i class="bi bi-plus-slash-minus me-1"></i>+@t.InitialScore handicap</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex gap-2">
                            <a asp-action="Manage" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-gear me-1"></i>Manage
                            </a>
                            <a asp-action="Report" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-bar-chart me-1"></i>Report
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
