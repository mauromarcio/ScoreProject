@* Partial: renders a list of TournamentMatch rows for pool play *@
@model IEnumerable<VolleyScore.Models.TournamentMatch>
@using VolleyScore.Models

<div class="list-group list-group-flush">
    @foreach (var tm in Model)
    {
        var m = tm.Match;
        if (m == null) continue;
        var statusClass = m.Status == MatchStatus.Completed ? "success" :
                          m.Status == MatchStatus.InProgress ? "warning" : "secondary";
        var homeSets = m.Sets.Count(s => s.WinnerTeamId == m.HomeTeamId);
        var awaySets = m.Sets.Count(s => s.WinnerTeamId == m.AwayTeamId);
        <a asp-controller="Matches" asp-action="Court" asp-route-id="@m.Id"
           class="list-group-item list-group-item-action">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted me-1 small">#@tm.MatchNumber</span>
                    <span class="fw-semibold">@m.HomeTeam?.Name</span>@if (tm.HomeTeamLongWait) {<span title="Long wait — team had 3 consecutive idle slots before this match" class="text-warning ms-1" style="font-size:.85em">★</span>}
                    <span class="text-muted mx-2">vs</span>
                    <span class="fw-semibold">@m.AwayTeam?.Name</span>@if (tm.AwayTeamLongWait) {<span title="Long wait — team had 3 consecutive idle slots before this match" class="text-warning ms-1" style="font-size:.85em">★</span>}
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (m.Status == MatchStatus.Completed)
                    {
                        <span class="fw-bold">@homeSets – @awaySets</span>
                    }
                    <span class="badge bg-@statusClass">@m.Status</span>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-1">
                @if (tm.RefereeTeam != null)
                {
                    <span class="small text-muted">
                        <i class="bi bi-whistle me-1"></i>Referee: <strong>@tm.RefereeTeam.Name</strong>
                    </span>
                }
                else { <span></span> }
                @if (m.Status == MatchStatus.Completed)
                {
                    <span class="text-muted small">
                        @string.Join("  |  ", m.Sets.OrderBy(s => s.SetNumber)
                            .Select(s => $"Set {s.SetNumber}: {s.HomeScore}–{s.AwayScore}"))
                    </span>
                }
            </div>
        </a>
    }
    @if (!Model.Any())
    {
        <div class="list-group-item text-muted text-center py-4">No pool matches yet.</div>
    }
</div>
