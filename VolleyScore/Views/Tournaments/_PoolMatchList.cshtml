@* Partial: renders pool match cards for one court (no JS — all JS lives in PoolPlay.cshtml) *@
@model IEnumerable<VolleyScore.Models.TournamentMatch>
@using VolleyScore.Models
@{
    var teamNums = ViewBag.TeamNumbers as Dictionary<int, int> ?? new Dictionary<int, int>();
    int TNum(int id) => teamNums.TryGetValue(id, out var n) ? n : 0;
}

<div class="match-list">
    @foreach (var tm in Model)
    {
        var m = tm.Match;
        if (m == null) continue;
        var statusClass = m.Status == MatchStatus.Completed ? "success" :
                          m.Status == MatchStatus.InProgress ? "warning" : "secondary";
        var homeSets = m.Sets.Count(s => s.WinnerTeamId == m.HomeTeamId);
        var awaySets = m.Sets.Count(s => s.WinnerTeamId == m.AwayTeamId);
        int homeNum = TNum(m.HomeTeamId);
        int awayNum = TNum(m.AwayTeamId);
        int refNum  = tm.RefereeTeamId.HasValue ? TNum(tm.RefereeTeamId.Value) : 0;
        <div class="match-card" draggable="true" data-tm-id="@tm.Id" data-match-id="@m.Id">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-1">
                    <span class="row-drag-handle" title="Drag to reorder match">
                        <i class="bi bi-grip-vertical"></i>
                    </span>
                    <a asp-controller="Matches" asp-action="Court" asp-route-id="@m.Id"
                       draggable="false"
                       class="text-muted small text-decoration-none"
                       title="Open match">
                        #<span class="match-num-val">@tm.MatchNumber</span>
                    </a>
                </div>
                <div class="d-flex align-items-center gap-1">
                    @if (m.Status == MatchStatus.Completed)
                    {
                        <span class="small fw-bold">@homeSets–@awaySets</span>
                    }
                    <span class="badge bg-@statusClass badge-status">@m.Status</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-1 flex-wrap mt-1">
                <span class="team-chip"
                      draggable="true"
                      data-tm-id="@tm.Id"
                      data-pos="home"
                      data-team-id="@m.HomeTeamId"
                      title="Drag to swap">
                    <span class="team-num">T@homeNum</span>
                    <span class="team-name">@m.HomeTeam?.Name</span>@if (tm.HomeTeamLongWait) {<span class="text-warning ms-1" title="3+ idle slots before this match">★</span>}
                </span>
                <span class="text-muted" style="font-size:.8em">vs</span>
                <span class="team-chip"
                      draggable="true"
                      data-tm-id="@tm.Id"
                      data-pos="away"
                      data-team-id="@m.AwayTeamId"
                      title="Drag to swap">
                    <span class="team-num">T@awayNum</span>
                    <span class="team-name">@m.AwayTeam?.Name</span>@if (tm.AwayTeamLongWait) {<span class="text-warning ms-1" title="3+ idle slots before this match">★</span>}
                </span>
            </div>

            @if (tm.RefereeTeam != null)
            {
                <div class="d-flex align-items-center gap-1 mt-1">
                    <i class="bi bi-whistle text-muted" style="font-size:.8em"></i>
                    <span class="team-chip team-chip-ref"
                          draggable="true"
                          data-tm-id="@tm.Id"
                          data-pos="ref"
                          data-team-id="@(tm.RefereeTeamId ?? 0)"
                          title="Drag to swap referee">
                        <span class="team-num">T@refNum</span>
                        <span class="team-name">@tm.RefereeTeam.Name</span>
                    </span>
                </div>
            }
        </div>
    }
    @if (!Model.Any())
    {
        <div class="text-muted text-center py-3 small">No matches.</div>
    }
</div>
