@* File: VolleyScore/Views/Tournaments/LiveBracket.cshtml *@
@* Purpose: Full-screen live bracket visualizer – auto-polls every 5 s, no page nav *@
@model VolleyScore.ViewModels.TournamentBracketViewModel
@{
    Layout = null; // standalone full-screen page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Tournament.Name — Live Bracket</title>
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0b1a35;
            color: #d8e8f8;
            font-family: Arial, sans-serif;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* ── Header ──────────────────────────────────────────────────────── */
        .viz-header {
            background: linear-gradient(90deg, #0f2044 0%, #1a3a70 100%);
            border-bottom: 2px solid #2a5a9e;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            flex-shrink: 0;
        }
        .viz-back {
            color: #8ab4d8;
            text-decoration: none;
            border: 1px solid #2a5a9e;
            border-radius: 6px;
            padding: 4px 12px;
            font-size: .8rem;
            white-space: nowrap;
        }
        .viz-back:hover { background: rgba(42,90,158,.3); color: #d8e8f8; }
        .viz-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .viz-title .ico { color: #ffd700; margin-right: 8px; }
        .live-pill {
            background: #b91c1c;
            color: #fff;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 3px 10px;
            border-radius: 20px;
            animation: blink 1.8s ease-in-out infinite;
        }
        @@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.4} }
        .viz-clock { font-size: .72rem; color: #6a9fd8; white-space: nowrap; }

        /* ── Body ────────────────────────────────────────────────────────── */
        .viz-body {
            display: flex;
            flex: 1;
            gap: 0;
            overflow: hidden;
        }

        /* ── Left Panel: Standings + Live Scores ─────────────────────────── */
        .left-panel {
            width: 360px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            gap: 0;
            border-right: 1px solid #1e3a65;
            overflow-y: auto;
        }
        .panel-section {
            padding: 12px 16px;
            border-bottom: 1px solid #1e3a65;
        }
        .section-hdr {
            font-size: .65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #5a8fc8;
            margin-bottom: 8px;
        }
        .pool-prog {
            font-size: .72rem;
            color: #8ab4d8;
            margin-bottom: 6px;
        }
        .prog-bar-wrap {
            background: #1a3560;
            border-radius: 4px;
            height: 5px;
            margin-bottom: 10px;
        }
        .prog-bar {
            background: linear-gradient(90deg, #2563eb, #38bdf8);
            border-radius: 4px;
            height: 5px;
            transition: width .6s ease;
        }

        /* standings table */
        .tbl { width: 100%; border-collapse: collapse; font-size: .8rem; }
        .tbl th {
            color: #5a8fc8; font-size: .65rem; text-transform: uppercase;
            padding: 3px 6px; border-bottom: 1px solid #1e3a65;
        }
        .tbl td { padding: 5px 6px; border-bottom: 1px solid #132745; }
        .tbl td:not(:first-child):not(:nth-child(2)) { text-align: center; }
        .rank-1 { background: rgba(255,215,0,.08); }
        .rank-2 { background: rgba(192,192,192,.06); }
        .rank-3 { background: rgba(205,127,50,.06); }
        .rank-4 { background: rgba(100,149,237,.05); }
        .sets-hi { color: #4ade80; font-weight: 700; }
        .ratio-dim { color: #7090b0; }

        /* live match cards */
        .live-card {
            background: rgba(255,255,255,.04);
            border: 1px solid #2a5a9e;
            border-radius: 7px;
            padding: 8px 12px;
            margin-bottom: 8px;
        }
        .live-card-hdr {
            font-size: .6rem;
            color: #5a8fc8;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }
        .score-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 2px 0;
        }
        .score-row .tname { font-size: .82rem; }
        .score-row .pts   { font-size: 1.3rem; font-weight: 700; color: #ffd700; min-width: 32px; text-align: center; }
        .score-row .sets  { font-size: .7rem; color: #5a8fc8; min-width: 22px; text-align: center; }
        .live-set-label { text-align: right; font-size: .6rem; color: #5a8fc8; margin-top: 2px; }
        .no-live { font-size: .78rem; color: #5a8fc8; text-align: center; padding: 14px 0; }

        /* ── Right Panel: Bracket ────────────────────────────────────────── */
        .right-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: auto;
            padding: 20px 30px;
        }
        .bracket-pending {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #5a8fc8;
        }
        .bracket-pending .big-ico { font-size: 4rem; }
        .bracket-pending .msg     { font-size: 1rem; }
        .bracket-pending .sub     { font-size: .8rem; color: #3a6090; }

        /* bracket layout */
        .bracket-wrap {
            display: flex;
            align-items: stretch;
            gap: 0;
            flex: 1;
        }
        .b-col {
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            gap: 0;
        }
        .b-col-label {
            font-size: .62rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #5a8fc8;
            margin-bottom: 6px;
        }
        .b-match {
            background: rgba(255,255,255,.05);
            border: 1px solid #2a5a9e;
            border-radius: 8px;
            padding: 10px 14px;
            min-width: 175px;
        }
        .b-match.is-live { border-color: #4ade80; }
        .b-match.is-final-box { border-color: #ffd700; background: rgba(255,215,0,.06); }
        .b-team-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 3px 0;
            font-size: .85rem;
            gap: 6px;
        }
        .b-team-row .bname { flex: 1; }
        .b-winner { color: #4ade80; font-weight: 700; }
        .b-sets {
            background: #1a3560;
            color: #d8e8f8;
            padding: 1px 7px;
            border-radius: 4px;
            font-size: .72rem;
            font-weight: 700;
            min-width: 22px;
            text-align: center;
        }
        .b-sets-win { background: #14532d; color: #4ade80; }
        .b-status { text-align: right; font-size: .6rem; margin-top: 4px; }
        .b-tbd { color: #3a6090; font-style: italic; font-size: .82rem; }

        /* connector lines */
        .conn {
            display: flex;
            flex-direction: column;
            width: 36px;
            flex-shrink: 0;
            align-self: stretch;
        }
        .conn-top {
            flex: 1;
            border-top: 2px solid #2a5a9e;
            border-right: 2px solid #2a5a9e;
        }
        .conn-bot {
            flex: 1;
            border-bottom: 2px solid #2a5a9e;
            border-right: 2px solid #2a5a9e;
        }
        .conn-h {
            width: 36px;
            flex-shrink: 0;
            border-top: 2px solid #ffd700;
            align-self: center;
        }

        /* Champion + 3rd place */
        .results-col {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 20px;
            padding-left: 10px;
        }
        .champion-box {
            background: linear-gradient(135deg, #7c5c00, #b8820a);
            border: 2px solid #ffd700;
            border-radius: 10px;
            padding: 16px 22px;
            text-align: center;
        }
        .champion-box .lbl { font-size: .65rem; text-transform: uppercase; letter-spacing: 2px; color: #ffd700; }
        .champion-box .name { font-size: 1.25rem; font-weight: 700; color: #fff; margin-top: 4px; }
        .third-box {
            background: rgba(255,255,255,.04);
            border: 1px solid #4a5568;
            border-radius: 8px;
            padding: 10px 16px;
            text-align: center;
        }
        .third-box .lbl  { font-size: .62rem; text-transform: uppercase; letter-spacing: 1px; color: #a0b4d0; }
        .third-box .name { font-size: 1rem; font-weight: 700; margin-top: 3px; }

        /* middle column: final + 3rd */
        .finals-col {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 24px;
        }
    </style>
</head>
<body>

<!-- ── Header ─────────────────────────────────────────────────────────────── -->
<div class="viz-header">
    <a href="/Tournaments" class="viz-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
    <div class="viz-title">
        <span class="ico"><i class="bi bi-trophy-fill"></i></span>@Model.Tournament.Name
    </div>
    <span class="live-pill">● LIVE</span>
    <span class="viz-clock" id="vizClock">—</span>
</div>

<!-- ── Body ───────────────────────────────────────────────────────────────── -->
<div class="viz-body">

    <!-- Left panel -->
    <div class="left-panel">

        <!-- Pool progress + standings -->
        <div class="panel-section">
            <div class="section-hdr"><i class="bi bi-bar-chart-fill me-1"></i>Pool Standings</div>
            <div class="pool-prog" id="poolProg">Loading…</div>
            <div class="prog-bar-wrap"><div class="prog-bar" id="progBar" style="width:0%"></div></div>
            <table class="tbl">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Team</th>
                        <th>MP</th>
                        <th>Sets</th>
                        <th>Ratio</th>
                    </tr>
                </thead>
                <tbody id="standingsBody"></tbody>
            </table>
        </div>

        <!-- Live match scores -->
        <div class="panel-section" style="flex:1">
            <div class="section-hdr"><i class="bi bi-activity me-1"></i>Live Matches</div>
            <div id="liveContainer"><div class="no-live">No live matches</div></div>
        </div>

    </div>

    <!-- Right panel: bracket -->
    <div class="right-panel">
        <div class="section-hdr" style="margin-bottom:16px"><i class="bi bi-diagram-3-fill me-1"></i>Playoff Bracket</div>
        <div id="bracketRoot" style="flex:1;display:flex;align-items:center"></div>
    </div>

</div>

<script>
(function () {
    'use strict';
    var TID = @Model.Tournament.Id;
    var POLL = 5000;
    var medals = ['🥇', '🥈', '🥉', '4️⃣'];

    function esc(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    /* ── Poll ─────────────────────────────────────────────────────────────── */
    function poll() {
        fetch('/Tournaments/LiveData/' + TID)
            .then(function (r) { return r.json(); })
            .then(function (d) {
                renderStandings(d.standings);
                renderLive(d.activeMatches);
                renderProgress(d.poolDone, d.poolTotal);
                renderBracket(d);
                document.getElementById('vizClock').textContent =
                    'Updated ' + new Date().toLocaleTimeString();
            })
            .catch(function (e) { console.warn('poll error', e); });
    }

    /* ── Standings ────────────────────────────────────────────────────────── */
    function renderStandings(rows) {
        if (!rows || !rows.length) {
            document.getElementById('standingsBody').innerHTML =
                '<tr><td colspan="5" style="text-align:center;padding:14px;color:#3a6090">No completed matches yet</td></tr>';
            return;
        }
        var html = '';
        rows.forEach(function (s, i) {
            var cls = i < 4 ? ' class="rank-' + (i + 1) + '"' : '';
            var medal = i < medals.length ? medals[i] : (i + 1) + '.';
            var ratio = s.pointsAgainst === 0 ? '—' : s.ratio.toFixed(3);
            html += '<tr' + cls + '>' +
                '<td>' + medal + '</td>' +
                '<td>' + esc(s.teamName) + '</td>' +
                '<td>' + s.matchesPlayed + '</td>' +
                '<td class="sets-hi">' + s.setsWon + '</td>' +
                '<td class="ratio-dim">' + ratio + '</td>' +
                '</tr>';
        });
        document.getElementById('standingsBody').innerHTML = html;
    }

    /* ── Progress bar ─────────────────────────────────────────────────────── */
    function renderProgress(done, total) {
        var pct = total > 0 ? Math.round(done / total * 100) : 0;
        document.getElementById('poolProg').textContent =
            'Pool matches: ' + done + ' / ' + total + ' completed (' + pct + '%)';
        document.getElementById('progBar').style.width = pct + '%';
    }

    /* ── Live match cards ─────────────────────────────────────────────────── */
    function renderLive(matches) {
        var c = document.getElementById('liveContainer');
        if (!matches || !matches.length) {
            c.innerHTML = '<div class="no-live">No live matches right now</div>';
            return;
        }
        var html = '';
        matches.forEach(function (m) {
            var lbl = m.stage === 'Pool'
                ? 'Court ' + m.courtNumber + ' · Match ' + m.matchNumber
                : m.stage;
            html += '<div class="live-card">' +
                '<div class="live-card-hdr">' + esc(lbl) + '</div>' +
                '<div class="score-row">' +
                    '<span class="tname">' + esc(m.homeTeam) + '</span>' +
                    '<div style="display:flex;align-items:center;gap:4px">' +
                        '<span class="sets">' + m.homeSets + '</span>' +
                        '<span class="pts">' + m.homeScore + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="score-row">' +
                    '<span class="tname">' + esc(m.awayTeam) + '</span>' +
                    '<div style="display:flex;align-items:center;gap:4px">' +
                        '<span class="sets">' + m.awaySets + '</span>' +
                        '<span class="pts">' + m.awayScore + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="live-set-label">Set ' + m.setNumber + '</div>' +
                '</div>';
        });
        c.innerHTML = html;
    }

    /* ── Bracket ──────────────────────────────────────────────────────────── */
    function matchBox(m, extraClass) {
        if (!m) {
            return '<div class="b-match' + (extraClass ? ' ' + extraClass : '') + '">' +
                '<div class="b-team-row"><span class="b-tbd">TBD</span></div>' +
                '<div class="b-team-row"><span class="b-tbd">TBD</span></div>' +
                '</div>';
        }
        var homeW = m.winnerName && m.winnerName === m.homeTeam;
        var awayW = m.winnerName && m.winnerName === m.awayTeam;
        var isLive = m.status === 'InProgress';
        var boxCls = 'b-match' + (isLive ? ' is-live' : '') + (extraClass ? ' ' + extraClass : '');
        return '<div class="' + boxCls + '">' +
            '<div class="b-team-row">' +
                '<span class="bname' + (homeW ? ' b-winner' : '') + '">' + esc(m.homeTeam) + '</span>' +
                '<span class="b-sets' + (homeW ? ' b-sets-win' : '') + '">' + m.homeSets + '</span>' +
            '</div>' +
            '<div class="b-team-row">' +
                '<span class="bname' + (awayW ? ' b-winner' : '') + '">' + esc(m.awayTeam) + '</span>' +
                '<span class="b-sets' + (awayW ? ' b-sets-win' : '') + '">' + m.awaySets + '</span>' +
            '</div>' +
            (isLive ? '<div class="b-status" style="color:#4ade80">● LIVE</div>' : '') +
            '</div>';
    }

    function renderBracket(d) {
        var root = document.getElementById('bracketRoot');

        if (!d.semifinals || !d.semifinals.length) {
            var pct = d.poolTotal > 0 ? Math.round(d.poolDone / d.poolTotal * 100) : 0;
            root.innerHTML =
                '<div class="bracket-pending">' +
                    '<div class="big-ico">🏐</div>' +
                    '<div class="msg">Playoff bracket not yet generated</div>' +
                    '<div class="sub">Pool play ' + pct + '% complete — semifinals are created after pool play finishes</div>' +
                '</div>';
            return;
        }

        var sf1 = d.semifinals[0] || null;
        var sf2 = d.semifinals[1] || null;
        var fm  = d.finalMatch   || null;
        var tp  = d.thirdPlaceMatch || null;
        var champion = fm && fm.winnerName ? fm.winnerName : null;
        var third    = tp && tp.winnerName ? tp.winnerName : null;

        var html = '<div class="bracket-wrap">';

        /* SF column */
        html += '<div class="b-col" style="gap:32px">' +
            '<div>' +
                '<div class="b-col-label">Semi-final 1</div>' +
                matchBox(sf1) +
            '</div>' +
            '<div>' +
                '<div class="b-col-label">Semi-final 2</div>' +
                matchBox(sf2) +
            '</div>' +
            '</div>';

        /* connector SF → Final */
        html += '<div class="conn"><div class="conn-top"></div><div class="conn-bot"></div></div>';

        /* Finals column */
        html += '<div class="finals-col">';
        if (fm) {
            html += '<div>' +
                '<div class="b-col-label" style="color:#ffd700">Final</div>' +
                matchBox(fm, 'is-final-box') +
                '</div>';
        } else {
            html += '<div>' +
                '<div class="b-col-label" style="color:#ffd700">Final</div>' +
                matchBox(null, 'is-final-box') +
                '</div>';
        }
        if (tp) {
            html += '<div style="margin-top:8px">' +
                '<div class="b-col-label">3rd Place</div>' +
                matchBox(tp) +
                '</div>';
        }
        html += '</div>';

        /* connector Final → Champion */
        if (champion) {
            html += '<div class="conn-h"></div>';
            html += '<div class="results-col">' +
                '<div class="champion-box">' +
                    '<div class="lbl">🏆 Champion</div>' +
                    '<div class="name">' + esc(champion) + '</div>' +
                '</div>';
            if (third) {
                html += '<div class="third-box">' +
                    '<div class="lbl">🥉 3rd Place</div>' +
                    '<div class="name">' + esc(third) + '</div>' +
                    '</div>';
            }
            html += '</div>';
        }

        html += '</div>'; /* bracket-wrap */
        root.innerHTML = html;
    }

    /* ── Init ─────────────────────────────────────────────────────────────── */
    poll();
    setInterval(poll, POLL);
})();
</script>
</body>
</html>
