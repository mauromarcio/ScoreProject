@* File: VolleyScore/Views/Tournaments/PoolSchedule.cshtml *@
@model VolleyScore.Models.Tournament
@using VolleyScore.Models
@{
    ViewData["Title"] = Model.Name + " – Pool Schedule";
    int matchCounter = 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tournament.css" asp-append-version="true" />
    <style>
        @@media print {
            nav, .btn-toolbar, .no-print { display: none !important; }
            .card { break-inside: avoid; page-break-inside: avoid; }
            body { font-size: 11pt; }
        }
        .result-badge { font-size: .85rem; font-weight: 700; white-space: nowrap; }
        .ref-label { white-space: nowrap; }
    </style>
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2 no-print">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 class="mb-0"><i class="bi bi-calendar3 me-2"></i>@Model.Name – Pool Schedule</h2>
                <small class="text-muted">@Model.TournamentTeams.Count teams &nbsp;|&nbsp; @Model.SetsPerMatch set(s)/match</small>
            </div>
        </div>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>

    <!-- Print-only header -->
    <div class="d-none d-print-block mb-3">
        <h3 class="mb-0">@Model.Name – Pool Schedule</h3>
        <small class="text-muted">@Model.TournamentTeams.Count teams &nbsp;|&nbsp; @Model.SetsPerMatch set(s)/match &nbsp;|&nbsp; Printed: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</small>
        <hr />
    </div>

    @foreach (var pool in Model.Pools.OrderBy(p => p.SortOrder))
    {
        var poolMatches = Model.TournamentMatches
            .Where(x => x.Phase == TournamentPhase.Pool && x.PoolId == pool.Id)
            .OrderBy(x => x.SortOrder)
            .ToList();

        if (!poolMatches.Any()) { continue; }

        int poolStartCounter = matchCounter;

        <div class="card mb-4">
            <div class="card-header fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-grid me-1"></i>@pool.Name
                <span class="badge bg-secondary fw-normal ms-auto">@poolMatches.Count match(es)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:52px">#</th>
                            <th>Home</th>
                            <th style="width:36px" class="text-center">vs</th>
                            <th>Away</th>
                            <th style="width:80px" class="text-center">
                                <i class="bi bi-whistle me-1"></i>Ref
                            </th>
                            <th style="width:90px" class="text-center">Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int pmi = 0; pmi < poolMatches.Count; pmi++)
                        {
                            var tm = poolMatches[pmi];
                            var match = tm.Match;
                            bool done = match?.Status == MatchStatus.Completed;
                            bool live = match?.Status == MatchStatus.InProgress;
                            int refIdx = (pmi + 2) % poolMatches.Count;
                            int refMNum = poolStartCounter + refIdx + 1;
                            <tr class="@(done ? "table-success" : live ? "table-warning" : "")">
                                <td class="fw-semibold text-muted">M@(++matchCounter)</td>
                                <td>@tm.HomeTeam?.Name</td>
                                <td class="text-center text-muted small">vs</td>
                                <td>@tm.AwayTeam?.Name</td>
                                <td class="text-center ref-label">
                                    @if (poolMatches.Count >= 3)
                                    {
                                        <span class="text-muted">M@(refMNum)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">–</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (done && match != null)
                                    {
                                        int h = match.Sets.Count(s => s.WinnerTeamId == match.HomeTeamId);
                                        int a = match.Sets.Count(s => s.WinnerTeamId == match.AwayTeamId);
                                        <span class="result-badge">@h – @a</span>
                                        <div class="text-muted" style="font-size:.72rem;line-height:1.3">
                                            @foreach (var set in match.Sets.OrderBy(s => s.SetNumber))
                                            {
                                                <div>Set @set.SetNumber: @set.HomeScore–@set.AwayScore</div>
                                            }
                                        </div>
                                    }
                                    else if (live)
                                    {
                                        <span class="badge bg-warning text-dark">Live</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">–</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
