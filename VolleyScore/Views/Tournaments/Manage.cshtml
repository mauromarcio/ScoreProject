@* File: VolleyScore/Views/Tournaments/Manage.cshtml *@
@model VolleyScore.Models.Tournament
@using VolleyScore.Models
@{
    ViewData["Title"] = Model.Name + " – Manage";
    var unpooled = (List<TournamentTeam>)ViewBag.UnpooledTeams;
    var availableTeams = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.AvailableTeams;
    bool hasSchedule = Model.TournamentMatches.Any(tm => tm.Phase == TournamentPhase.Pool);
    bool hasPools = Model.Pools.Any();
    bool hasKnockouts = Model.TournamentMatches.Any(tm => tm.Phase != TournamentPhase.Pool);
    bool hasQFs = Model.TournamentMatches.Any(tm => tm.Phase == TournamentPhase.QuarterFinal);
    bool isDoubles = Model.TournamentType == TournamentType.Doubles;
    var crossPoolMatches = Model.TournamentMatches.Where(tm => tm.Phase == TournamentPhase.Pool && tm.PoolId == null).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/tournament.css" asp-append-version="true" />
}

<div class="container-fluid py-3 px-4">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 class="mb-0">@Model.Name</h2>
                <small class="text-muted">
                    @if (isDoubles) { <span class="badge me-1" style="background:#0d9488"><i class="bi bi-person-arms-up me-1"></i>Doubles</span> }
                    @Model.TournamentTeams.Count @(isDoubles ? "pairs" : "teams") &nbsp;|&nbsp;
                    @Model.SetsPerMatch sets/match
                    @if (Model.InitialScore > 0) { <span>&nbsp;|&nbsp;+@Model.InitialScore handicap</span> }
                    @if (isDoubles) { <span>&nbsp;|&nbsp;@Model.NumberOfPools pools</span> }
                    &nbsp;|&nbsp;Win: @Model.PointsToWin pts
                    @if (Model.PointsCap > 0) { <span>&nbsp;|&nbsp;Cap: @Model.PointsCap</span> }
                    &nbsp;|&nbsp; Status: <strong>@Model.Status</strong>
                </small>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Report" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
                <i class="bi bi-bar-chart me-1"></i>Report
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Delete tournament \'@Model.Name\'? This will remove all related data and cannot be undone.')">
                <button type="submit" class="btn btn-danger btn-sm">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible mb-3" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible mb-3" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (hasSchedule)
    {
        <div class="card border-info mb-4">
            <div class="card-header fw-semibold d-flex align-items-center gap-2" style="color:#0d6efd">
                <i class="bi bi-sliders"></i> Match Settings
                <small class="text-muted fw-normal ms-1">— applies to future matches only</small>
            </div>
            <div class="card-body py-2">
                <form asp-action="UpdateSettings" asp-route-id="@Model.Id" method="post">
                    @{
                        var spm  = Model.SetsPerMatch;
                        var ptw  = Model.PointsToWin;
                        var pc   = Model.PointsCap;
                        var qfs  = Model.PlayoffSetsPerMatch;
                        var sfs  = Model.SemifinalSetsPerMatch;
                        var fins = Model.FinalSetsPerMatch;
                    }
                    <div class="row g-2 align-items-end flex-wrap">
                        <div class="col-auto">
                            <label class="form-label small fw-semibold mb-1">Pool Sets</label>
                            <select name="setsPerMatch" class="form-select form-select-sm">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <option value="@i" selected="@(spm == i)">@i set@(i > 1 ? "s" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label small fw-semibold mb-1">Points to Win</label>
                            <select name="pointsToWin" class="form-select form-select-sm">
                                <option value="11" selected="@(ptw == 11)">11 pts</option>
                                <option value="15" selected="@(ptw == 15)">15 pts</option>
                                <option value="21" selected="@(ptw == 21)">21 pts</option>
                                <option value="25" selected="@(ptw == 25)">25 pts</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label small fw-semibold mb-1">Point Cap</label>
                            <select name="pointsCap" class="form-select form-select-sm">
                                <option value="0"  selected="@(pc == 0)">No cap</option>
                                <option value="13" selected="@(pc == 13)">13 (11-pt)</option>
                                <option value="17" selected="@(pc == 17)">17 (15-pt)</option>
                                <option value="23" selected="@(pc == 23)">23</option>
                                <option value="27" selected="@(pc == 27)">27</option>
                                <option value="28" selected="@(pc == 28)">28</option>
                                <option value="30" selected="@(pc == 30)">30</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label small fw-semibold mb-1">QF Sets</label>
                            <select name="playoffSetsPerMatch" class="form-select form-select-sm">
                                <option value="1" selected="@(qfs == 1)">1 set</option>
                                <option value="2" selected="@(qfs == 2)">2 sets</option>
                                <option value="3" selected="@(qfs == 3)">Best of 3</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label small fw-semibold mb-1">SF Sets</label>
                            <select name="semifinalSetsPerMatch" class="form-select form-select-sm">
                                <option value="1" selected="@(sfs == 1)">1 set</option>
                                <option value="2" selected="@(sfs == 2)">2 sets</option>
                                <option value="3" selected="@(sfs == 3)">Best of 3</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label small fw-semibold mb-1">Final Sets</label>
                            <select name="finalSetsPerMatch" class="form-select form-select-sm">
                                <option value="1" selected="@(fins == 1)">1 set</option>
                                <option value="2" selected="@(fins == 2)">2 sets</option>
                                <option value="3" selected="@(fins == 3)">Best of 3</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-check me-1"></i>Save
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="row g-4">

        <!-- LEFT: Team enrollment -->
        <div class="col-lg-3">
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-people me-1"></i>Teams
                    <span class="badge bg-secondary ms-1">@Model.TournamentTeams.Count / @Model.MaxTeams</span>
                </div>
                <div class="card-body p-2">
                    <!-- Enrolled teams list -->
                    <ul class="list-group list-group-flush mb-2" id="enrolledTeamsList">
                        @foreach (var tt in Model.TournamentTeams.OrderBy(x => x.SeedPosition))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-1 px-2">
                                <span class="small">
                                    <span class="badge bg-light text-dark me-1">#@tt.SeedPosition</span>
                                    @tt.Team?.Name
                                </span>
                                <form asp-action="RemoveTeam" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="tournamentTeamId" value="@tt.Id" />
                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0"
                                            title="Remove"
                                            onclick="return confirm('Remove @tt.Team?.Name?')">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>

                    <!-- Add team form -->
                    @if (availableTeams.Any() && Model.TournamentTeams.Count < Model.MaxTeams)
                    {
                        <form asp-action="AddTeam" method="post" class="d-flex gap-1 mt-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="teamId" class="form-select form-select-sm">
                                <option value="">Add team…</option>
                                @foreach (var item in availableTeams)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-success text-nowrap">
                                <i class="bi bi-plus"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- MIDDLE: Pool setup -->
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-grid-3x3-gap me-1"></i>Pools</span>
                    <div class="d-flex gap-2">
                        @if (isDoubles)
                        {
                            <form asp-action="SuggestPools" asp-route-id="@Model.Id" method="post">
                                <input type="hidden" name="poolSize" value="0" />
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"
                                        title="Distribute evenly into @Model.NumberOfPools pool(s)">
                                    <i class="bi bi-magic me-1"></i>Distribute (@Model.NumberOfPools pools)
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="SuggestPools" asp-route-id="@Model.Id" method="post" class="d-flex gap-1">
                                <input type="number" name="poolSize" value="4" min="2" max="20"
                                       class="form-control form-control-sm" style="width:60px" title="Teams per pool" />
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                                    <i class="bi bi-magic me-1"></i>Auto
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body p-2">
                    @if (!hasPools)
                    {
                        <p class="text-muted small text-center py-3">
                            No pools yet. Enroll teams and click <strong>Auto</strong> to suggest pools,
                            or adjust the pool size.
                        </p>
                    }
                    else
                    {
                        <div id="poolsContainer">
                            @foreach (var pool in Model.Pools.OrderBy(p => p.SortOrder))
                            {
                                <div class="pool-card mb-3" data-pool-id="@pool.Id">
                                    <div class="pool-header">@pool.Name</div>
                                    <ul class="sortable-pool list-unstyled mb-0"
                                        data-pool-id="@pool.Id">
                                        @foreach (var pt in pool.PoolTeams.OrderBy(x => x.SortOrder))
                                        {
                                            <li class="pool-team-item"
                                                data-tt-id="@pt.TournamentTeamId">
                                                <i class="bi bi-grip-vertical text-muted me-1"></i>
                                                @pt.TournamentTeam?.Team?.Name
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>

                        <form asp-action="GenerateSchedule" asp-route-id="@Model.Id" method="post" class="mt-2">
                            <button type="submit" class="btn btn-primary btn-sm w-100"
                                    onclick="return confirm('Generate round-robin schedule? This will replace any existing pool matches.')">
                                <i class="bi bi-calendar-week me-1"></i>Generate Schedule
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: Matches list + knockouts -->
        <div class="col-lg-4">

            @if (hasSchedule || hasPools)
            {
                @{ int matchCounter = 0; }
                @foreach (var pool in Model.Pools.OrderBy(p => p.SortOrder))
                {
                    var poolMatches = Model.TournamentMatches
                        .Where(x => x.Phase == TournamentPhase.Pool && x.PoolId == pool.Id)
                        .OrderBy(x => x.SortOrder)
                        .ToList();
                    var allTeams = Model.TournamentTeams
                        .OrderBy(tt => tt.SeedPosition)
                        .Select(tt => new { id = tt.TeamId, name = tt.Team?.Name ?? "" })
                        .ToList();

                    <div class="card mb-2">
                        <div class="card-header fw-semibold py-2 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-grid me-1"></i>@pool.Name Matches</span>
                            <span class="badge bg-secondary">@poolMatches.Count match(es)</span>
                        </div>
                        <div class="card-body p-0">
                            @if (poolMatches.Any())
                            {
                                <table class="table table-sm table-hover mb-0">
                                    <tbody class="sortable-match-list" data-pool-id="@pool.Id">
                                        @foreach (var tm in poolMatches)
                                        {
                                            var match = tm.Match;
                                            bool done = match?.Status == MatchStatus.Completed;
                                            matchCounter++;
                                            <tr class="match-row @(done ? "table-success" : "")" data-match-id="@tm.Id">
                                                <td style="width:20px;cursor:grab" class="text-muted match-drag-handle">
                                                    <i class="bi bi-grip-vertical"></i>
                                                </td>
                                                <td class="small fw-semibold text-muted">M@matchCounter</td>
                                                <td class="small">@tm.HomeTeam?.Name</td>
                                                <td class="small text-muted">vs</td>
                                                <td class="small">@tm.AwayTeam?.Name</td>
                                                <td class="small">
                                                    @if (done && match != null) { int h = match.Sets.Count(s => s.WinnerTeamId == match.HomeTeamId); int a = match.Sets.Count(s => s.WinnerTeamId == match.AwayTeamId); <strong>@h–@a</strong> }
                                                    else if (match?.Status == MatchStatus.InProgress) { <span class="badge bg-warning text-dark">Live</span> }
                                                    else { <span class="text-muted">–</span> }
                                                </td>
                                                <td class="text-end" style="white-space:nowrap">
                                                    @if (match == null) { <a asp-action="StartTournamentMatch" asp-route-id="@Model.Id" asp-route-tournamentMatchId="@tm.Id" class="btn btn-xs btn-outline-primary me-1" title="Start"><i class="bi bi-play-fill"></i></a> }
                                                    else { <a asp-controller="Matches" asp-action="Court" asp-route-id="@match.Id" class="btn btn-xs btn-outline-secondary me-1" title="Court"><i class="bi bi-display"></i></a> }
                                                    <form asp-action="DeletePoolMatch" method="post" class="d-inline" onsubmit="return confirm('Delete this match?')">
                                                        <input type="hidden" name="id" value="@Model.Id" />
                                                        <input type="hidden" name="tournamentMatchId" value="@tm.Id" />
                                                        <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete match">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted small text-center py-2 mb-0">No matches yet.</p>
                            }
                            <!-- Add Match form – all enrolled teams available -->
                            @if (allTeams.Count >= 2)
                            {
                                <form asp-action="AddPoolMatch" method="post" class="d-flex gap-1 p-2 border-top align-items-center flex-wrap">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="poolId" value="@pool.Id" />
                                    <select name="homeTeamId" class="form-select form-select-sm" style="min-width:130px">
                                        @foreach (var t in allTeams) { <option value="@t.id">@t.name</option> }
                                    </select>
                                    <span class="small text-muted fw-bold">vs</span>
                                    <select name="awayTeamId" class="form-select form-select-sm" style="min-width:130px">
                                        @foreach (var t in allTeams) { <option value="@t.id">@t.name</option> }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">
                                        <i class="bi bi-plus me-1"></i>Add Match
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }

                @if (isDoubles && crossPoolMatches.Any())
                {
                    <!-- Cross-pool matches (Doubles) -->
                    <div class="card mb-2">
                        <div class="card-header fw-semibold">
                            <i class="bi bi-shuffle me-1"></i>Cross-Pool Matches
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr><th>Match</th><th>Home</th><th>Away</th><th>Result</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var tm in crossPoolMatches.OrderBy(x => x.SortOrder))
                                    {
                                        var match = tm.Match;
                                        bool done = match?.Status == MatchStatus.Completed;
                                        matchCounter++;
                                        <tr class="@(done ? "table-success" : "")">
                                            <td class="small fw-semibold text-muted">M@matchCounter</td>
                                            <td class="small">@tm.HomeTeam?.Name</td>
                                            <td class="small">@tm.AwayTeam?.Name</td>
                                            <td class="small">
                                                @if (done && match != null) { int h = match.Sets.Count(s => s.WinnerTeamId == match.HomeTeamId); int a = match.Sets.Count(s => s.WinnerTeamId == match.AwayTeamId); <strong>@h – @a</strong> }
                                                else if (match?.Status == MatchStatus.InProgress) { <span class="badge bg-warning text-dark">Live</span> }
                                                else { <span class="text-muted">–</span> }
                                            </td>
                                            <td class="text-end" style="white-space:nowrap">
                                                @if (match == null) { <a asp-action="StartTournamentMatch" asp-route-id="@Model.Id" asp-route-tournamentMatchId="@tm.Id" class="btn btn-xs btn-outline-primary me-1"><i class="bi bi-play-fill"></i></a> }
                                                else { <a asp-controller="Matches" asp-action="Court" asp-route-id="@match.Id" class="btn btn-xs btn-outline-secondary me-1"><i class="bi bi-display"></i></a> }
                                                <form asp-action="DeletePoolMatch" method="post" class="d-inline" onsubmit="return confirm('Delete this match?')">
                                                    <input type="hidden" name="id" value="@Model.Id" />
                                                    <input type="hidden" name="tournamentMatchId" value="@tm.Id" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete match">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Generate Knockouts button (bottom of pool matches) -->
                <form asp-action="GenerateKnockouts" asp-route-id="@Model.Id" method="post" class="mb-3">
                    <button type="submit" class="btn btn-warning btn-sm w-100"
                            onclick="return confirm('Generate knockout bracket from current standings?')">
                        <i class="bi bi-trophy me-1"></i>Generate Knockouts
                    </button>
                </form>
            }

            @if (hasKnockouts)
            {
                <!-- Knockout bracket -->
                <div class="card">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-trophy me-1"></i>Knockouts
                        @if (hasQFs) { <span class="badge bg-primary ms-1">8-team bracket</span> }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Match</th>
                                    <th>Home</th>
                                    <th>Away</th>
                                    <th>Result</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tm in Model.TournamentMatches
                                    .Where(x => x.Phase != TournamentPhase.Pool)
                                    .OrderBy(x => x.Phase == TournamentPhase.QuarterFinal ? 0 : x.Phase == TournamentPhase.SemiFinal ? 1 : x.Phase == TournamentPhase.ThirdPlace ? 2 : x.Phase == TournamentPhase.Final ? 3 : 4)
                                    .ThenBy(x => x.SortOrder))
                                {
                                    var match = tm.Match;
                                    bool done = match?.Status == MatchStatus.Completed;
                                    var srcHome = tm.HomeSourceMatchId.HasValue ? Model.TournamentMatches.FirstOrDefault(x => x.Id == tm.HomeSourceMatchId) : null;
                                    var srcAway = tm.AwaySourceMatchId.HasValue ? Model.TournamentMatches.FirstOrDefault(x => x.Id == tm.AwaySourceMatchId) : null;
                                    string homeLabel = tm.HomeTeam?.Name ?? (srcHome != null ? $"{(tm.HomeFromWinner ? "W" : "L")}/{srcHome.Label}" : "TBD");
                                    string awayLabel = tm.AwayTeam?.Name ?? (srcAway != null ? $"{(tm.AwayFromWinner ? "W" : "L")}/{srcAway.Label}" : "TBD");
                                    <tr class="@(done ? "table-success" : "")">
                                        <td class="small fw-semibold">@tm.Label</td>
                                        <td class="small">@homeLabel</td>
                                        <td class="small">@awayLabel</td>
                                        <td class="small">
                                            @if (done && match != null)
                                            {
                                                int h = match.Sets.Count(s => s.WinnerTeamId == match.HomeTeamId);
                                                int a = match.Sets.Count(s => s.WinnerTeamId == match.AwayTeamId);
                                                <strong>@h – @a</strong>
                                            }
                                            else if (match != null && match.Status == MatchStatus.InProgress)
                                            {
                                                <span class="badge bg-warning text-dark">Live</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">–</span>
                                            }
                                        </td>
                                        <td>
                                            @if (match == null && tm.HomeTeamId.HasValue && tm.AwayTeamId.HasValue)
                                            {
                                                <a asp-action="StartTournamentMatch"
                                                   asp-route-id="@Model.Id"
                                                   asp-route-tournamentMatchId="@tm.Id"
                                                   class="btn btn-xs btn-outline-primary"
                                                   title="Start match">
                                                    <i class="bi bi-play-fill"></i>
                                                </a>
                                            }
                                            else if (match != null)
                                            {
                                                <a asp-controller="Matches" asp-action="Court"
                                                   asp-route-id="@match.Id"
                                                   class="btn btn-xs btn-outline-secondary"
                                                   title="Open court">
                                                    <i class="bi bi-display"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
<script>
    var TOURNAMENT_ID = @Model.Id;
</script>
<script src="~/js/tournament.js" asp-append-version="true"></script>
}
