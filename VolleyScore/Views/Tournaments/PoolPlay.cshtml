@* File: VolleyScore/Views/Tournaments/PoolPlay.cshtml *@
@model VolleyScore.ViewModels.TournamentPoolViewModel
@using VolleyScore.Models
@{
    ViewData["Title"] = Model.Tournament.Name + " – Pool Play";
    var completedCount = Model.PoolMatches.Count(m => m.Match?.Status == MatchStatus.Completed);
    var totalCount     = Model.PoolMatches.Count;
    int numCourts      = Math.Max(1, Model.Tournament.NumberOfCourts);

    var courtGroups = Model.PoolMatches
        .GroupBy(tm => tm.CourtNumber == 0 ? 1 : tm.CourtNumber)
        .OrderBy(g => g.Key)
        .ToList();
    bool multiCourt = courtGroups.Count > 1;

    // Build team-number lookup (SeedOrder) and pass to partial via ViewBag
    var teamNumbers = Model.Tournament.TournamentTeams
        .ToDictionary(tt => tt.TeamId, tt => tt.SeedOrder);
    ViewBag.TeamNumbers = teamNumbers;
}

<style>
    /* ── Match cards ─────────────────────────────────────────────────────── */
    .match-list { }
    .match-card {
        padding: 8px 10px;
        border-bottom: 1px solid #dee2e6;
        background: #fff;
        user-select: none;
    }
    .match-card:last-child { border-bottom: none; }
    .match-card:hover { background: #f8f9fa; }
    .match-card.is-dragging { opacity: 0.35; }
    .match-card.drop-above  { border-top: 2px solid #0d6efd !important; }
    .match-card.drop-below  { border-bottom: 2px solid #0d6efd !important; }

    .row-drag-handle { color: #ced4da; cursor: grab; }
    .row-drag-handle:hover { color: #6c757d; }

    /* ── Team chips ──────────────────────────────────────────────────────── */
    .team-chip {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 7px;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        background: #f8f9fa;
        font-size: .8rem;
        cursor: grab;
        white-space: nowrap;
        transition: background .1s, border-color .1s, outline .1s;
    }
    .team-chip:hover      { background: #e9ecef; border-color: #adb5bd; }
    .team-chip.is-dragging { opacity: 0.4; cursor: grabbing; }
    .team-chip.drop-target {
        outline: 2px solid #0d6efd;
        background: #dce8ff;
        border-color: #0d6efd;
    }
    .team-chip .team-num  { color: #6c757d; font-size: .75em; font-weight: 700; }
    .team-chip-ref        { border-style: dashed; }

    /* ── Lock state ──────────────────────────────────────────────────────── */
    .schedule-locked .team-chip     { cursor: default; }
    .schedule-locked .row-drag-handle { cursor: default; pointer-events: none; }
    .schedule-locked .match-card    { cursor: default; }

    /* ── Badge compact ───────────────────────────────────────────────────── */
    .badge-status { font-size: .7em !important; }

    /* ── Buffer area chips ───────────────────────────────────────────────── */
    .buffer-chip { background: #fff8e1; border-color: #ffe082; }
    .buffer-chip:hover { background: #ffecb3; border-color: #ffc107; }
    #buffer-chips-body { min-height: 48px; }
</style>

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Details" asp-route-id="@Model.Tournament.Id" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-fill">
            <h2 class="mb-0">@Model.Tournament.Name – Pool Play</h2>
            <p class="text-muted mb-0 small">@completedCount / @totalCount matches completed</p>
        </div>
        <a asp-action="PoolPlayReport" asp-route-id="@Model.Tournament.Id"
           class="btn btn-outline-secondary btn-sm ms-2" target="_blank" title="Print pool schedule">
            <i class="bi bi-printer me-1"></i> Print
        </a>
        @if (Model.Tournament.Status == TournamentStatus.PoolPlay)
        {
            <form asp-action="GeneratePlayoffs" asp-route-id="@Model.Tournament.Id" method="post" class="ms-2">
                <button type="submit" class="btn btn-warning btn-sm"
                        onclick="return confirm('Generate semi-finals from current standings?')">
                    <i class="bi bi-diagram-3 me-1"></i> Semi-finals
                </button>
            </form>
        }
    </div>

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ── Standings ──────────────────────────────────────────────── -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><strong>Standings</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Team</th>
                                <th class="text-center" title="Sets Won">SW</th>
                                <th class="text-center" title="Points Made">PM</th>
                                <th class="text-center" title="Points Against">PA</th>
                                <th class="text-center" title="Points Ratio">Ratio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Standings.Count; i++)
                            {
                                var s = Model.Standings[i];
                                var rowClass = i == 0 ? "table-success" : i == 1 ? "table-info" :
                                               i == 2 ? "table-warning" : i == 3 ? "table-secondary" : "";
                                <tr class="@rowClass">
                                    <td class="fw-bold">@(i + 1)</td>
                                    <td>
                                        @{ int tn = teamNumbers.GetValueOrDefault(s.TeamId, 0); }
                                        @if (tn > 0) { <span class="text-muted small me-1">T@(tn)</span> }
                                        @s.TeamName
                                    </td>
                                    <td class="text-center fw-bold">@s.SetsWon</td>
                                    <td class="text-center">@s.PointsMade</td>
                                    <td class="text-center">@s.PointsAgainst</td>
                                    <td class="text-center">
                                        @(s.PointsAgainst == 0 && s.PointsMade == 0 ? "–" :
                                          s.PointsRatio == double.MaxValue ? "∞" :
                                          s.PointsRatio.ToString("F3"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small">
                    SW = Sets Won &nbsp;|&nbsp; PM = Points Made &nbsp;|&nbsp; PA = Points Against
                </div>
            </div>

            @if (Model.Standings.Count >= 4)
            {
                <div class="card mt-3">
                    <div class="card-header"><strong>Projected Semi-finals</strong></div>
                    <div class="card-body">
                        <p class="mb-1 small">
                            <span class="badge bg-success me-1">SF1</span>
                            <strong>@Model.Standings[0].TeamName</strong>
                            <span class="text-muted">(1st)</span> vs
                            <strong>@Model.Standings[3].TeamName</strong>
                            <span class="text-muted">(4th)</span>
                        </p>
                        <p class="mb-0 small">
                            <span class="badge bg-info me-1">SF2</span>
                            <strong>@Model.Standings[1].TeamName</strong>
                            <span class="text-muted">(2nd)</span> vs
                            <strong>@Model.Standings[2].TeamName</strong>
                            <span class="text-muted">(3rd)</span>
                        </p>
                    </div>
                </div>
            }

            <!-- ── Schedule stats (live, updates with every drag) ────── -->
            <div class="card mt-3" id="schedule-stats-card">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <strong class="small">Schedule Stats</strong>
                    <span class="badge bg-secondary" style="font-size:.65em;letter-spacing:.03em">LIVE</span>
                </div>
                <div class="card-body p-0" id="schedule-stats-body">
                    <div class="text-muted text-center small py-3">Loading…</div>
                </div>
            </div>

            <!-- ── Buffer Teams Area ──────────────────────────────────── -->
            <div class="card mt-3" id="buffer-area-card">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <strong class="small"><i class="bi bi-collection me-1"></i>Buffer Area</strong>
                    <span class="text-muted" style="font-size:.72em">Drag a chip to any match slot to place</span>
                </div>
                <div class="card-body p-2" id="buffer-chips-body">
                    <div class="d-flex flex-wrap gap-2" id="buffer-chips">
                        @foreach (var tt in Model.Tournament.TournamentTeams.OrderBy(t => t.SeedOrder))
                        {
                            <span class="team-chip buffer-chip" draggable="true"
                                  data-pos="buffer" data-team-id="@tt.TeamId">
                                <span class="team-num">T@(tt.SeedOrder)</span>
                                <span class="team-name">@(tt.Team?.Name ?? "?")</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Match lists (courts side-by-side) ─────────────────────── -->
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong>Pool Matches</strong>
                    <span class="text-muted small ms-2">
                        Drag <i class="bi bi-grip-vertical"></i> to reorder · Drag
                        <span style="border:1px solid #dee2e6;border-radius:3px;padding:0 4px;font-size:.8em">T# Name</span>
                        to swap teams or referee
                    </span>
                </div>
                <button id="lock-toggle" class="btn btn-sm btn-outline-secondary" type="button" title="Lock schedule to prevent accidental drags">
                    <i id="lock-icon" class="bi bi-unlock me-1"></i><span class="lock-label">Lock</span>
                </button>
            </div>

            <div class="row g-2" id="courts-container">
                @foreach (var cg in courtGroups)
                {
                    var done  = cg.Count(m => m.Match?.Status == MatchStatus.Completed);
                    var total = cg.Count();
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <strong class="small">@(multiCourt ? $"Court {cg.Key}" : "Matches")</strong>
                                <span class="badge @(done == total && total > 0 ? "bg-success" : "bg-secondary") ms-1">
                                    @done/@total
                                </span>
                            </div>
                            @await Html.PartialAsync("_PoolMatchList", cg.OrderBy(m => m.MatchNumber).ToList())
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<!-- Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
    <div id="pool-toast" class="toast align-items-center border-0" role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="pool-toast-msg"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
(function () {
    var tournamentId  = @Model.Tournament.Id;
    var numTeams      = @Model.Tournament.TournamentTeams.Count;
    var expectedPlays = numTeams - 1;   // full round-robin: each team plays vs every other once
    var lockKey       = 'vsScheduleLocked_' + tournamentId;
    var locked        = localStorage.getItem(lockKey) === 'true';

    // ── Lock ──────────────────────────────────────────────────────────────────

    function applyLock() {
        var btn       = document.getElementById('lock-toggle');
        var icon      = document.getElementById('lock-icon');
        var container = document.getElementById('courts-container');
        if (locked) {
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-warning');
            icon.className = 'bi bi-lock-fill me-1';
            btn.querySelector('.lock-label').textContent = 'Locked';
            container.classList.add('schedule-locked');
        } else {
            btn.classList.remove('btn-warning');
            btn.classList.add('btn-outline-secondary');
            icon.className = 'bi bi-unlock me-1';
            btn.querySelector('.lock-label').textContent = 'Lock';
            container.classList.remove('schedule-locked');
        }
    }

    document.getElementById('lock-toggle').addEventListener('click', function () {
        locked = !locked;
        localStorage.setItem(lockKey, locked);
        applyLock();
    });

    applyLock();
    renderStats(); // initial render

    // ── Toast ─────────────────────────────────────────────────────────────────

    function showToast(msg, type) {
        var el = document.getElementById('pool-toast');
        if (!el || !window.bootstrap) return;
        el.className = 'toast align-items-center border-0 text-bg-' + (type || 'success');
        document.getElementById('pool-toast-msg').textContent = msg;
        bootstrap.Toast.getOrCreateInstance(el, { delay: 2000 }).show();
    }

    // ── Drag state ────────────────────────────────────────────────────────────

    var dragType      = null;   // 'chip' | 'row'
    var dragSrcEl     = null;   // the dragged element
    var dragFromHandle = false; // last mousedown was on the grip handle

    // ── Mouse-down: detect handle press ───────────────────────────────────────

    document.addEventListener('mousedown', function (e) {
        dragFromHandle = !!e.target.closest('.row-drag-handle');
    }, true);

    // ── Drag-start ────────────────────────────────────────────────────────────

    document.addEventListener('dragstart', function (e) {
        if (locked) { e.preventDefault(); return; }

        var chip = e.target.closest('.team-chip');
        var card = e.target.closest('.match-card');

        if (chip) {
            // Team-chip drag (home / away / ref)
            dragType  = 'chip';
            dragSrcEl = chip;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', 'chip');
            chip.classList.add('is-dragging');
            // Stop propagation so the parent .match-card doesn't also fire dragstart
            e.stopPropagation();
        } else if (card && dragFromHandle) {
            // Row drag — only from the grip handle
            dragType  = 'row';
            dragSrcEl = card;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', 'row');
            setTimeout(function () { card.classList.add('is-dragging'); }, 0);
        } else {
            e.preventDefault(); // Ignore drags from non-handle areas
        }
        dragFromHandle = false;
    }, true);

    // ── Drag-end ──────────────────────────────────────────────────────────────

    document.addEventListener('dragend', function () {
        if (dragSrcEl) {
            dragSrcEl.classList.remove('is-dragging');
        }
        clearChipTargets();
        clearRowIndicators();
        dragType = null; dragSrcEl = null;
    }, true);

    // ── Drag-over ─────────────────────────────────────────────────────────────

    document.addEventListener('dragover', function (e) {
        if (dragType === 'chip') {
            var chip = e.target.closest('.team-chip');
            if (chip && chip !== dragSrcEl) {
                // Ignore buffer → buffer drags (no-op)
                if (dragSrcEl.dataset.pos === 'buffer' && chip.dataset.pos === 'buffer') return;
                e.preventDefault();
                clearChipTargets();
                chip.classList.add('drop-target');
            }
        } else if (dragType === 'row') {
            var card = e.target.closest('.match-card');
            if (card && card !== dragSrcEl) {
                e.preventDefault();
                clearRowIndicators();
                var midY = card.getBoundingClientRect().top + card.getBoundingClientRect().height / 2;
                card.classList.add(e.clientY < midY ? 'drop-above' : 'drop-below');
            }
        }
    }, true);

    document.addEventListener('dragleave', function (e) {
        if (dragType === 'chip') {
            var chip = e.target.closest('.team-chip');
            if (chip) chip.classList.remove('drop-target');
        } else if (dragType === 'row') {
            var card = e.target.closest('.match-card');
            if (card) card.classList.remove('drop-above', 'drop-below');
        }
    }, true);

    // ── Drop ──────────────────────────────────────────────────────────────────

    document.addEventListener('drop', function (e) {
        e.preventDefault();

        if (dragType === 'chip') {
            var targetChip = e.target.closest('.team-chip');
            clearChipTargets();
            if (!targetChip || targetChip === dragSrcEl) return;

            var srcIsBuffer = dragSrcEl.dataset.pos === 'buffer';
            var tgtIsBuffer = targetChip.dataset.pos === 'buffer';

            if (!srcIsBuffer && !tgtIsBuffer) {
                // Match chip ↔ match chip: standard swap
                swapTeamPositions(
                    parseInt(dragSrcEl.dataset.tmId, 10), dragSrcEl.dataset.pos,
                    parseInt(targetChip.dataset.tmId, 10), targetChip.dataset.pos
                );
            } else if (srcIsBuffer && !tgtIsBuffer) {
                // Buffer → match: put buffer team into match slot
                assignTeamToPosition(
                    parseInt(targetChip.dataset.tmId, 10), targetChip.dataset.pos,
                    parseInt(dragSrcEl.dataset.teamId, 10),
                    dragSrcEl, targetChip
                );
            } else if (!srcIsBuffer && tgtIsBuffer) {
                // Match → buffer: put buffer chip's team into match slot
                assignTeamToPosition(
                    parseInt(dragSrcEl.dataset.tmId, 10), dragSrcEl.dataset.pos,
                    parseInt(targetChip.dataset.teamId, 10),
                    targetChip, dragSrcEl
                );
            }
            // buffer → buffer: no-op

        } else if (dragType === 'row') {
            var targetCard = e.target.closest('.match-card');
            clearRowIndicators();
            if (!targetCard || targetCard === dragSrcEl) return;

            var list = targetCard.closest('.match-list');
            if (!list) return;

            var rect   = targetCard.getBoundingClientRect();
            var before = e.clientY < rect.top + rect.height / 2;
            if (before) list.insertBefore(dragSrcEl, targetCard);
            else        targetCard.after(dragSrcEl);

            var ids = Array.from(list.querySelectorAll('.match-card'))
                .map(function (c) { return parseInt(c.dataset.tmId, 10); });
            saveMatchOrder(ids, list);
        }
    }, true);

    // ── Helpers ───────────────────────────────────────────────────────────────

    function clearChipTargets() {
        document.querySelectorAll('.team-chip.drop-target')
            .forEach(function (c) { c.classList.remove('drop-target'); });
    }

    function clearRowIndicators() {
        document.querySelectorAll('.match-card.drop-above, .match-card.drop-below')
            .forEach(function (c) { c.classList.remove('drop-above', 'drop-below'); });
    }

    // ── API ───────────────────────────────────────────────────────────────────

    function swapTeamPositions(fromTmId, fromPos, toTmId, toPos) {
        fetch('/Tournaments/SwapTeamPositions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'fromTmId=' + fromTmId + '&fromPos=' + encodeURIComponent(fromPos) +
                  '&toTmId=' + toTmId   + '&toPos='   + encodeURIComponent(toPos)
        })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (d) {
            updateChip(fromTmId, fromPos, d.fromTeamId, d.fromTeamName, d.fromTeamNum);
            updateChip(d.toTmId, d.toPos, d.toTeamId,  d.toTeamName,  d.toTeamNum);
            showToast('Swapped: T' + d.fromTeamNum + ' ' + d.fromTeamName +
                      ' ↔ T' + d.toTeamNum + ' ' + d.toTeamName, 'success');
            renderStats();
        })
        .catch(function () { showToast('Swap failed — please try again.', 'danger'); });
    }

    // bufferChip  — the buffer-area chip that gets the displaced team
    // matchChip   — the match-slot chip that gets the new team
    function assignTeamToPosition(tmId, pos, newTeamId, bufferChip, matchChip) {
        fetch('/Tournaments/AssignTeamToPosition', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'tmId=' + tmId + '&pos=' + encodeURIComponent(pos) + '&newTeamId=' + newTeamId
        })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (d) {
            if (!d.success) { showToast('Assignment failed.', 'danger'); return; }
            // Update match chip to show the team that was just placed
            matchChip.dataset.teamId = d.newTeamId;
            var mNum  = matchChip.querySelector('.team-num');
            var mName = matchChip.querySelector('.team-name');
            if (mNum)  mNum.textContent  = 'T' + d.newTeamNum;
            if (mName) mName.textContent = d.newTeamName || '—';
            // Update buffer chip to show the displaced team
            bufferChip.dataset.teamId = d.displacedId;
            var bNum  = bufferChip.querySelector('.team-num');
            var bName = bufferChip.querySelector('.team-name');
            if (bNum)  bNum.textContent  = 'T' + d.displacedNum;
            if (bName) bName.textContent = d.displacedName || '—';
            showToast('T' + d.newTeamNum + ' ' + d.newTeamName + ' placed; T' + d.displacedNum + ' ' + d.displacedName + ' returned to buffer.', 'success');
            renderStats();
        })
        .catch(function () { showToast('Assignment failed — please try again.', 'danger'); });
    }

    function updateChip(tmId, pos, teamId, teamName, teamNum) {
        var chip = document.querySelector(
            '.team-chip[data-tm-id="' + tmId + '"][data-pos="' + pos + '"]');
        if (!chip) return;
        chip.dataset.teamId = teamId;
        var numEl  = chip.querySelector('.team-num');
        var nameEl = chip.querySelector('.team-name');
        if (numEl)  numEl.textContent  = 'T' + teamNum;
        if (nameEl) nameEl.textContent = teamName || '—';
    }

    function saveMatchOrder(ids, list) {
        fetch('/Tournaments/ReorderMatches', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tournamentMatchIds: ids })
        })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (d) {
            if (!d.success) return;
            d.matches.forEach(function (m) {
                var card = list.querySelector('.match-card[data-tm-id="' + m.id + '"]');
                if (card) {
                    var el = card.querySelector('.match-num-val');
                    if (el) el.textContent = m.matchNumber;
                }
            });
            showToast('Order saved.', 'success');
        })
        .catch(function () { showToast('Could not save order — please try again.', 'danger'); });
    }

    // ── Schedule stats ────────────────────────────────────────────────────────

    function computeStats() {
        // Collect distinct court numbers from DOM
        var courtsSet = {};
        document.querySelectorAll('.match-card[data-court]').forEach(function (c) {
            courtsSet[parseInt(c.dataset.court) || 1] = true;
        });
        var courts = Object.keys(courtsSet).map(Number).sort(function (a, b) { return a - b; });

        var teams = {}; // teamId → { num, name, plays:{courtNum→count}, refs }

        function getOrCreate(chip) {
            var id = chip.dataset.teamId;
            if (!id || id === '0') return null;
            if (!teams[id]) {
                var numEl  = chip.querySelector('.team-num');
                var nameEl = chip.querySelector('.team-name');
                teams[id] = {
                    id:   id,
                    num:  numEl  ? parseInt(numEl.textContent.replace(/\D/g, ''), 10) : 0,
                    name: nameEl ? nameEl.textContent.trim() : '—',
                    plays: {},
                    refs:  0
                };
            }
            return teams[id];
        }

        document.querySelectorAll('.match-card').forEach(function (card) {
            var court = parseInt(card.dataset.court, 10) || 1;
            ['home', 'away'].forEach(function (pos) {
                var chip = card.querySelector('.team-chip[data-pos="' + pos + '"]');
                if (!chip) return;
                var t = getOrCreate(chip);
                if (t) t.plays[court] = (t.plays[court] || 0) + 1;
            });
            var ref = card.querySelector('.team-chip[data-pos="ref"]');
            if (ref) { var t = getOrCreate(ref); if (t) t.refs++; }
        });

        return { teams: teams, courts: courts };
    }

    function renderStats() {
        var body = document.getElementById('schedule-stats-body');
        if (!body) return;

        var data   = computeStats();
        var courts = data.courts;
        var teams  = Object.values(data.teams)
            .sort(function (a, b) { return a.num - b.num; });

        if (teams.length === 0) {
            body.innerHTML = '<div class="text-muted small text-center py-3">No matches yet.</div>';
            return;
        }

        var html = '<div class="table-responsive">'
            + '<table class="table table-sm table-bordered mb-0" style="font-size:.78em">'
            + '<thead class="table-light"><tr>'
            + '<th>Team</th>'
            + '<th class="text-center" title="Total matches as player">Plays</th>';

        courts.forEach(function (c) {
            html += '<th class="text-center" title="Plays on court ' + c + '">C' + c + '</th>';
        });
        html += '<th class="text-center" title="Times refereeing">Refs</th>'
             + '</tr></thead><tbody>';

        teams.forEach(function (t) {
            var total = courts.reduce(function (s, c) { return s + (t.plays[c] || 0); }, 0);
            var ok    = total === expectedPlays;
            var badge = '<span class="badge ' + (ok ? 'bg-success' : 'bg-danger')
                + '" title="' + (ok ? '' : 'Expected ' + expectedPlays) + '">'
                + total + '</span>';

            html += '<tr>'
                + '<td class="text-nowrap"><span class="text-muted me-1" style="font-size:.85em">T'
                + t.num + '</span>' + escHtml(t.name) + '</td>'
                + '<td class="text-center">' + badge + '</td>';

            courts.forEach(function (c) {
                html += '<td class="text-center">' + (t.plays[c] || 0) + '</td>';
            });
            html += '<td class="text-center text-muted">' + t.refs + '</td></tr>';
        });

        html += '</tbody></table></div>';
        body.innerHTML = html;
    }

    function escHtml(s) {
        return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

})();
</script>
