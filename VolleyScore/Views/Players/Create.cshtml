@* File: VolleyScore/Views/Players/Create.cshtml *@
@model VolleyScore.Models.Player
@{
    ViewData["Title"] = "Add Player";
}

<div class="container py-4" style="max-width:520px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" asp-route-teamId="@Model.TeamId"
           class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0">Add Player</h2>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="TeamId" class="form-label fw-semibold">Team</label>
                    <select asp-for="TeamId" asp-items="ViewBag.Teams" class="form-select">
                        <option value="">-- Select Team --</option>
                    </select>
                    <span asp-validation-for="TeamId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Number" class="form-label fw-semibold">Jersey #</label>
                    <input asp-for="Number" type="number" class="form-control" min="1" max="99"
                           placeholder="e.g. 10" />
                    <span asp-validation-for="Number" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold">Player Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Full name" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i> Add Player
                    </button>
                    <a asp-action="Index" asp-route-teamId="@Model.TeamId"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
