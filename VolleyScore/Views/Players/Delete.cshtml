@* File: VolleyScore/Views/Players/Delete.cshtml *@
@model VolleyScore.Models.Player
@{
    ViewData["Title"] = "Delete Player";
}

<div class="container py-4" style="max-width:520px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" asp-route-teamId="@Model.TeamId"
           class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0 text-danger">Delete Player</h2>
    </div>

    <div class="card border-danger">
        <div class="card-body p-4">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Are you sure you want to delete player <strong>#@Model.Number @Model.Name</strong>?
            </div>

            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>
                <dt class="col-sm-4">Jersey #</dt>
                <dd class="col-sm-8">@Model.Number</dd>
                <dt class="col-sm-4">Team</dt>
                <dd class="col-sm-8">@Model.Team?.Name</dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex gap-2 mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
                <a asp-action="Index" asp-route-teamId="@Model.TeamId"
                   class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
