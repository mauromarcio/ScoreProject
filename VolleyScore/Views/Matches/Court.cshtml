@* File: VolleyScore/Views/Matches/Court.cshtml *@
@* Purpose: Main operational court view. Drag-drop player setup, real-time scoring, rotation control. *@
@model VolleyScore.ViewModels.MatchCourtViewModel
@{
    ViewData["Title"] = Model.Match.MatchReference + " – Court";
    Layout = "_Layout";

    // Determine which team visually appears on each side based on HomeTeamOnLeft flag
    var leftTeam  = Model.HomeTeamOnLeft ? Model.HomeTeam  : Model.AwayTeam;
    var rightTeam = Model.HomeTeamOnLeft ? Model.AwayTeam  : Model.HomeTeam;
    var leftPlayers  = Model.HomeTeamOnLeft ? Model.HomePlayers  : Model.AwayPlayers;
    var rightPlayers = Model.HomeTeamOnLeft ? Model.AwayPlayers  : Model.HomePlayers;
    var leftPositions  = Model.HomeTeamOnLeft ? Model.HomeCourtPositions : Model.AwayCourtPositions;
    var rightPositions = Model.HomeTeamOnLeft ? Model.AwayCourtPositions : Model.HomeCourtPositions;
    var leftSide  = Model.HomeTeamOnLeft ? "Home" : "Away";
    var rightSide = Model.HomeTeamOnLeft ? "Away" : "Home";
    var leftSetsWon  = Model.HomeTeamOnLeft ? Model.HomeSetsWon  : Model.AwaySetsWon;
    var rightSetsWon = Model.HomeTeamOnLeft ? Model.AwaySetsWon : Model.HomeSetsWon;
    bool leftIsServing  = Model.HomeTeamOnLeft ? Model.HomeIsServing : !Model.HomeIsServing;
    bool rightIsServing = !leftIsServing;
    int leftScore  = Model.HomeTeamOnLeft ? Model.CurrentSet.HomeScore  : Model.CurrentSet.AwayScore;
    int rightScore = Model.HomeTeamOnLeft ? Model.CurrentSet.AwayScore : Model.CurrentSet.HomeScore;
}

@section Styles {
    <link rel="stylesheet" href="~/css/court.css" asp-append-version="true" />
}

<!-- Pass model data to JavaScript (all strings JSON-serialized to be injection-safe) -->
<script>
    var COURT_DATA = {
        matchId: @Model.Match.Id,
        setNumber: @Model.CurrentSet.SetNumber,
        matchStatus: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Match.Status.ToString())),
        homeTeamId: @Model.HomeTeam.Id,
        awayTeamId: @Model.AwayTeam.Id,
        homeTeamName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HomeTeam.Name)),
        awayTeamName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AwayTeam.Name)),
        homeTeamOnLeft: @Model.HomeTeamOnLeft.ToString().ToLower(),
        homeIsServing: @Model.HomeIsServing.ToString().ToLower(),
        homeSetsWon: @Model.HomeSetsWon,
        awaySetsWon: @Model.AwaySetsWon,
        totalSets: @Model.TotalSets,
        homeScore: @Model.CurrentSet.HomeScore,
        awayScore: @Model.CurrentSet.AwayScore,
        initialScore: @Model.Match.InitialScore
    };
</script>

<div class="court-page" id="courtPage">

    <!-- ── Top score area ─────────────────────────────────────────────────── -->
    <div class="score-area">

        <!-- Left team name + sets won -->
        <div class="team-score-block">
            <div class="team-name-header" id="leftTeamName">@leftTeam.Name</div>
            <div id="leftSetsDisplay">
                @for (int i = 0; i < Model.TotalSets / 2 + 1; i++)
                {
                    <span class="set-dot @(i < leftSetsWon ? "won" : "")" data-index="@i"></span>
                }
            </div>
            @if (leftIsServing)
            {
                <span class="serving-indicator @(leftSide == "Home" ? "home-serving" : "away-serving")" id="leftServingBadge">
                    <i class="bi bi-volleyball"></i> SERVING
                </span>
            }
            else
            {
                <span class="serving-indicator" id="leftServingBadge" style="visibility:hidden">
                    <i class="bi bi-volleyball"></i> SERVING
                </span>
            }
        </div>

        <!-- Left score digits -->
        <div class="score-display" id="leftScoreDisplay">
            @{
                var ls = leftScore.ToString("D2");
            }
            <div class="score-digit" id="leftDigit0">@ls[0]</div>
            <div class="score-digit" id="leftDigit1">@ls[1]</div>
        </div>

        <!-- Score controls for left team -->
        <div class="d-flex flex-column gap-1">
            <button class="score-btn score-btn-up" id="btnLeftUp" title="Add point"
                    onclick="addPoint('@leftSide')">
                <i class="bi bi-chevron-up"></i>
            </button>
            <button class="score-btn score-btn-down" id="btnLeftDown" title="Subtract point"
                    onclick="subtractPoint('@leftSide')">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>

        <!-- Set info in the middle -->
        <div class="set-info mx-2">
            <span class="set-label">SET</span>
            <div class="set-number-display" id="setNumberDisplay">@Model.CurrentSet.SetNumber</div>
            <span class="set-label">of @Model.TotalSets</span>
        </div>

        <!-- Score controls for right team -->
        <div class="d-flex flex-column gap-1">
            <button class="score-btn score-btn-up" id="btnRightUp" title="Add point"
                    onclick="addPoint('@rightSide')">
                <i class="bi bi-chevron-up"></i>
            </button>
            <button class="score-btn score-btn-down" id="btnRightDown" title="Subtract point"
                    onclick="subtractPoint('@rightSide')">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>

        <!-- Right score digits -->
        <div class="score-display" id="rightScoreDisplay">
            @{
                var rs = rightScore.ToString("D2");
            }
            <div class="score-digit" id="rightDigit0">@rs[0]</div>
            <div class="score-digit" id="rightDigit1">@rs[1]</div>
        </div>

        <!-- Right team name + sets won -->
        <div class="team-score-block">
            @if (rightIsServing)
            {
                <span class="serving-indicator @(rightSide == "Home" ? "home-serving" : "away-serving")" id="rightServingBadge">
                    <i class="bi bi-volleyball"></i> SERVING
                </span>
            }
            else
            {
                <span class="serving-indicator" id="rightServingBadge" style="visibility:hidden">
                    <i class="bi bi-volleyball"></i> SERVING
                </span>
            }
            <div id="rightSetsDisplay">
                @for (int i = 0; i < Model.TotalSets / 2 + 1; i++)
                {
                    <span class="set-dot @(i < rightSetsWon ? "won" : "")" data-index="@i"></span>
                }
            </div>
            <div class="team-name-header" id="rightTeamName">@rightTeam.Name</div>
        </div>
    </div>

    <!-- ── Main court area ────────────────────────────────────────────────── -->
    <div class="court-body">

        <!-- Left roster panel -->
        <div class="player-roster" id="leftRoster">
            <div class="roster-header">@leftTeam.Name</div>
            <div class="roster-list" id="leftRosterList">
                @foreach (var p in leftPlayers)
                {
                    var onCourt = leftPositions.Any(pos => pos.Player?.Id == p.Id);
                    <div class="player-badge @(onCourt ? "on-court" : "")"
                         data-player-id="@p.Id"
                         data-player-number="@p.Number"
                         data-player-name="@p.Name"
                         data-team-id="@p.TeamId"
                         data-side="@leftSide"
                         id="badge-@p.Id">
                        <div class="player-number-circle">@p.Number</div>
                        <span class="player-name-label">@p.Name</span>
                    </div>
                }
            </div>
            @{
                var leftCompletedSets = Model.Match.Sets
                    .Where(s => s.SetNumber < Model.CurrentSet.SetNumber)
                    .OrderBy(s => s.SetNumber).ToList();
            }
            @if (leftCompletedSets.Any())
            {
                <div class="set-history" id="leftSetHistory">
                    @foreach (var s in leftCompletedSets)
                    {
                        var sc = leftSide == "Home" ? s.HomeScore : s.AwayScore;
                        <div class="set-history-item">
                            <span class="set-history-label">Set @s.SetNumber</span>
                            <span class="set-history-score">@sc</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Court canvas + rotate buttons -->
        <div class="court-canvas-wrapper">
        <div class="court-canvas" id="courtCanvas">

            <!-- Left court half -->
            <div class="court-half left-half" id="leftHalf" data-side="@leftSide">
                @foreach (var slot in leftPositions)
                {
                    <div class="position-slot @(slot.Player != null ? "occupied" : "") @(leftIsServing && slot.Position == 1 ? "pos-1 serving-team" : $"pos-{slot.Position}")"
                         data-position="@slot.Position"
                         data-side="@leftSide"
                         title="Position @slot.Position">
                        @if (slot.Player != null)
                        {
                            <span class="slot-number">@slot.Player.Number</span>
                            <span class="slot-player-name">@slot.Player.Name</span>
                        }
                        else
                        {
                            <span class="slot-number" style="color:#bbb">@slot.Position</span>
                        }
                    </div>
                }
            </div>

            <!-- Net -->
            <div class="court-net"></div>

            <!-- Right court half -->
            <div class="court-half right-half" id="rightHalf" data-side="@rightSide">
                @foreach (var slot in rightPositions)
                {
                    <div class="position-slot @(slot.Player != null ? "occupied" : "") @(rightIsServing && slot.Position == 1 ? "pos-1 serving-team" : $"pos-{slot.Position}")"
                         data-position="@slot.Position"
                         data-side="@rightSide"
                         title="Position @slot.Position">
                        @if (slot.Player != null)
                        {
                            <span class="slot-number">@slot.Player.Number</span>
                            <span class="slot-player-name">@slot.Player.Name</span>
                        }
                        else
                        {
                            <span class="slot-number" style="color:#bbb">@slot.Position</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Rotation buttons below each court half -->
        <div class="court-rotate-bar">
            <div class="rotate-btns-left">
                <button class="rotate-btn" onclick="rotatePositions('@leftSide', 'back')">
                    <i class="bi bi-arrow-counterclockwise"></i> Rotate Back
                </button>
                <button class="rotate-btn rotate-btn-initial" onclick="applyInitialRotation('@leftSide')"
                        title="Apply saved initial rotation for @leftTeam.Name">
                    <i class="bi bi-arrow-repeat"></i> Initial
                </button>
                <button class="rotate-btn" onclick="rotatePositions('@leftSide', 'forward')">
                    Rotate Forward <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="rotate-btns-right">
                <button class="rotate-btn" onclick="rotatePositions('@rightSide', 'back')">
                    <i class="bi bi-arrow-counterclockwise"></i> Rotate Back
                </button>
                <button class="rotate-btn rotate-btn-initial" onclick="applyInitialRotation('@rightSide')"
                        title="Apply saved initial rotation for @rightTeam.Name">
                    <i class="bi bi-arrow-repeat"></i> Initial
                </button>
                <button class="rotate-btn" onclick="rotatePositions('@rightSide', 'forward')">
                    Rotate Forward <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        </div>@* end court-canvas-wrapper *@

        <!-- Right roster panel -->
        <div class="player-roster away-roster" id="rightRoster">
            <div class="roster-header">@rightTeam.Name</div>
            <div class="roster-list" id="rightRosterList">
                @foreach (var p in rightPlayers)
                {
                    var onCourt = rightPositions.Any(pos => pos.Player?.Id == p.Id);
                    <div class="player-badge @(onCourt ? "on-court" : "")"
                         data-player-id="@p.Id"
                         data-player-number="@p.Number"
                         data-player-name="@p.Name"
                         data-team-id="@p.TeamId"
                         data-side="@rightSide"
                         id="badge-@p.Id">
                        <div class="player-number-circle">@p.Number</div>
                        <span class="player-name-label">@p.Name</span>
                    </div>
                }
            </div>
            @{
                var rightCompletedSets = Model.Match.Sets
                    .Where(s => s.SetNumber < Model.CurrentSet.SetNumber)
                    .OrderBy(s => s.SetNumber).ToList();
            }
            @if (rightCompletedSets.Any())
            {
                <div class="set-history" id="rightSetHistory">
                    @foreach (var s in rightCompletedSets)
                    {
                        var sc = rightSide == "Home" ? s.HomeScore : s.AwayScore;
                        <div class="set-history-item">
                            <span class="set-history-label">Set @s.SetNumber</span>
                            <span class="set-history-score">@sc</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <div class="court-toolbar">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary toolbar-btn">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <button id="btnSwitchSides" class="btn btn-outline-warning toolbar-btn"
                    onclick="switchSides()">
                <i class="bi bi-arrow-left-right me-1"></i> Switch Sides
            </button>
            <button id="btnStartMatch" class="btn btn-success toolbar-btn"
                    onclick="startMatch()"
                    style="@(Model.Match.Status == MatchStatus.InProgress || Model.Match.Status == MatchStatus.Completed ? "display:none" : "")">
                <i class="bi bi-play-fill me-1"></i> Start Match
            </button>
            <button id="btnToggleServe" class="btn btn-outline-warning toolbar-btn"
                    onclick="toggleFirstServe()"
                    @(Model.Match.Status != MatchStatus.Setup ? "disabled" : "")>
                <i class="bi bi-volleyball me-1"></i> First Serve: <span id="serveTeamLabel">@(leftIsServing ? leftTeam.Name : rightTeam.Name)</span>
            </button>
            <button id="btnToggleTally" class="btn btn-outline-info toolbar-btn"
                    onclick="toggleTallyPanel()">
                <i class="bi bi-table me-1"></i> Score Tally
            </button>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span id="matchStatusText" class="badge fs-6 @(Model.Match.Status == MatchStatus.InProgress ? "bg-success" : Model.Match.Status == MatchStatus.Completed ? "bg-dark" : "bg-secondary")">
                @Model.Match.Status
            </span>
            <a asp-controller="Score" asp-action="Display" asp-route-id="@Model.Match.Id"
               class="btn btn-dark toolbar-btn" target="_blank">
                <i class="bi bi-display me-1"></i> Open Display Screen
            </a>
        </div>
    </div>
</div>

<!-- ── Score Tally Panel (floating, draggable, resizable) ─────────────── -->
<div id="scoreTallyPanel" class="score-tally-panel" style="display:none">
    <div class="tally-handle" id="tallyHandle">
        <span class="tally-title">Score Tally</span>
        <div class="tally-handle-btns">
            <button class="tally-handle-btn" id="tallyMinBtn" title="Minimize / Expand" onclick="toggleTallyContent()">−</button>
        </div>
    </div>
    <div class="tally-content" id="tallyContent">
        <table class="tally-table" id="tallyTable">
            <!-- Populated by court.js initTallyPanel() -->
        </table>
        <div class="tally-server-row" id="tallyServerRow">
            <div class="tally-server-cell" id="tallyServerLeft">
                <span class="server-label">Server</span>
                <span class="server-name" id="tallyServerNameLeft">–</span>
            </div>
            <div class="tally-server-sep"></div>
            <div class="tally-server-cell" id="tallyServerRight">
                <span class="server-label">Server</span>
                <span class="server-name" id="tallyServerNameRight">–</span>
            </div>
        </div>
    </div>
</div>

<!-- ── Match Complete Overlay ──────────────────────────────────────────── -->
<div class="court-overlay" id="matchCompleteOverlay" style="display:none">
    <div class="court-overlay-card">
        <i class="bi bi-trophy-fill text-warning" style="font-size:3rem"></i>
        <h2 class="mt-3 fw-bold" id="winnerText">Winner!</h2>
        <p class="text-muted" id="winnerSubText">Match complete</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
            <a asp-action="Index" class="btn btn-primary">Back to Matches</a>
            <button class="btn btn-outline-secondary" onclick="document.getElementById('matchCompleteOverlay').style.display='none'">
                Continue Viewing
            </button>
        </div>
    </div>
</div>

<!-- ── Set Complete Overlay ────────────────────────────────────────────── -->
<div class="court-overlay" id="setCompleteOverlay" style="display:none">
    <div class="court-overlay-card">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
        <h3 class="mt-3 fw-bold" id="setWinnerText">Set Complete!</h3>
        <p class="text-muted" id="setCompleteSubText">Starting next set...</p>
        <button class="btn btn-success mt-3" onclick="dismissSetComplete()">
            <i class="bi bi-arrow-right me-1"></i> Continue
        </button>
    </div>
</div>

<!-- ── Error Toast ──────────────────────────────────────────────────────── -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 3000">
    <div id="errorToast" class="toast align-items-center text-bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="errorToastMessage">Error</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/court.js" asp-append-version="true"></script>
}
