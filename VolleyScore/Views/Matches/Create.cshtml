@* File: VolleyScore/Views/Matches/Create.cshtml *@
@model VolleyScore.Models.Match
@{
    ViewData["Title"] = "New Match";
}

<div class="container py-4" style="max-width:560px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0">Create New Match</h2>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="MatchReference" class="form-label fw-semibold">
                        Match Reference
                    </label>
                    <input asp-for="MatchReference" class="form-control"
                           placeholder="e.g. Final 2024 – Court A" autofocus />
                    <span asp-validation-for="MatchReference" class="text-danger small"></span>
                    <div class="form-text">A short identifier for this match.</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="HomeTeamId" class="form-label fw-semibold">Home Team</label>
                        <select asp-for="HomeTeamId" asp-items="ViewBag.HomeTeams"
                                class="form-select">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="HomeTeamId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AwayTeamId" class="form-label fw-semibold">Away Team</label>
                        <select asp-for="AwayTeamId" asp-items="ViewBag.AwayTeams"
                                class="form-select">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="AwayTeamId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalSets" class="form-label fw-semibold">Number of Sets</label>
                    <div class="d-flex flex-wrap gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TotalSets"
                                   value="1" id="sets1" />
                            <label class="form-check-label" for="sets1">1 Set</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TotalSets"
                                   value="2" id="sets2" />
                            <label class="form-check-label" for="sets2">2 Sets</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TotalSets"
                                   value="3" id="sets3" checked />
                            <label class="form-check-label" for="sets3">Best of 3</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TotalSets"
                                   value="4" id="sets4" />
                            <label class="form-check-label" for="sets4">4 Sets</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TotalSets"
                                   value="5" id="sets5" />
                            <label class="form-check-label" for="sets5">Best of 5</label>
                        </div>
                    </div>
                    <div class="form-text" id="setsHelpText">First to win 2 sets wins the match.</div>
                    <span asp-validation-for="TotalSets" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="InitialScore" class="form-label fw-semibold">
                        Initial Score (Fair Play)
                    </label>
                    <div class="d-flex align-items-center gap-2">
                        <input asp-for="InitialScore" type="number" class="form-control"
                               style="width:100px" min="0" max="24" value="0" />
                        <span class="text-muted small">points per team at start of each set</span>
                    </div>
                    <span asp-validation-for="InitialScore" class="text-danger small"></span>
                    <div class="form-text">Set to 0 for standard play. Use a value like 4 to give both teams a head start.</div>
                </div>

                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    After creating the match you will be taken to the <strong>Court View</strong>
                    where you can drag players to their starting positions before beginning play.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Create Match
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Update the help text based on selected sets
        document.querySelectorAll('input[name="TotalSets"]').forEach(function(radio) {
            radio.addEventListener('change', function() {
                var n = parseInt(this.value);
                var helpEl = document.getElementById('setsHelpText');
                var setsToWin = Math.floor(n / 2) + 1;
                if (n === 1) {
                    helpEl.textContent = 'Single set match – winner of the set wins.';
                } else if (n % 2 === 0) {
                    helpEl.textContent = 'Play all ' + n + ' sets. First to ' + setsToWin + ' set wins (tiebreaker if tied).';
                } else {
                    helpEl.textContent = 'Best of ' + n + ' – first to win ' + setsToWin + ' sets wins the match.';
                }
            });
        });
    </script>
}
