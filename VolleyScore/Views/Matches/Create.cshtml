@* File: VolleyScore/Views/Matches/Create.cshtml *@
@model VolleyScore.Models.Match
@{
    ViewData["Title"] = "New Match";
}

<div class="container py-4" style="max-width:560px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="mb-0">Create New Match</h2>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="MatchReference" class="form-label fw-semibold">
                        Match Reference
                    </label>
                    <input asp-for="MatchReference" class="form-control"
                           placeholder="e.g. Final 2024 – Court A" autofocus />
                    <span asp-validation-for="MatchReference" class="text-danger small"></span>
                    <div class="form-text">A short identifier for this match.</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="HomeTeamId" class="form-label fw-semibold">Home Team</label>
                        <select asp-for="HomeTeamId" asp-items="ViewBag.HomeTeams"
                                class="form-select">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="HomeTeamId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AwayTeamId" class="form-label fw-semibold">Away Team</label>
                        <select asp-for="AwayTeamId" asp-items="ViewBag.AwayTeams"
                                class="form-select">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="AwayTeamId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="TotalSets" class="form-label fw-semibold">Sets to Play</label>
                        <select asp-for="TotalSets" class="form-select">
                            <option value="1">1 set (to 25)</option>
                            <option value="2">2 sets (best of 2)</option>
                            <option value="3" selected>Best of 3 (1st to 2 sets)</option>
                            <option value="4">Best of 4</option>
                            <option value="5">Best of 5 (1st to 3 sets)</option>
                        </select>
                        <span asp-validation-for="TotalSets" class="text-danger small"></span>
                        <div class="form-text">Sets 1–(n-1) play to 25; deciding set plays to 15.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InitialScore" class="form-label fw-semibold">
                            Initial Score (handicap)
                        </label>
                        <input asp-for="InitialScore" type="number" min="0" max="24"
                               class="form-control" placeholder="0" />
                        <span asp-validation-for="InitialScore" class="text-danger small"></span>
                        <div class="form-text">Both teams start each set at this score. 0 = normal.</div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="PointsToWin" class="form-label fw-semibold">Points to Win Set</label>
                        <select asp-for="PointsToWin" class="form-select">
                            <option value="11">11 (quick)</option>
                            <option value="15">15 (deciding set)</option>
                            <option value="21">21 (beach)</option>
                            <option value="25" selected>25 (standard)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PointsCap" class="form-label fw-semibold">Point Cap (0 = no cap)</label>
                        <select asp-for="PointsCap" class="form-select">
                            <option value="0" selected>No cap</option>
                            <option value="13">13 (for 11-pt set)</option>
                            <option value="17">17 (for 15-pt set)</option>
                            <option value="23">23</option>
                            <option value="27">27</option>
                            <option value="28">28</option>
                            <option value="30">30</option>
                        </select>
                        <div class="form-text">Team reaching cap wins regardless of lead.</div>
                    </div>
                </div>

                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    After creating the match you will be taken to the <strong>Court View</strong>
                    where you can drag players to their starting positions before beginning play.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Create Match
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
