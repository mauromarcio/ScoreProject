@* File: VolleyScore/Views/Home/Index.cshtml *@
@model IEnumerable<VolleyScore.Models.Match>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4 px-4">
    <div class="row g-4">

        <!-- Quick Actions -->
        <div class="col-12">
            <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                <h2 class="mb-0 fw-bold"><i class="bi bi-volleyball me-2 text-primary"></i>VolleyScore Dashboard</h2>
                <a asp-controller="Matches" asp-action="Create" class="btn btn-primary ms-auto">
                    <i class="bi bi-plus-circle me-1"></i> New Match
                </a>
                <a asp-controller="Teams" asp-action="Create" class="btn btn-outline-secondary">
                    <i class="bi bi-people me-1"></i> New Team
                </a>
            </div>
            <hr class="mt-2" />
        </div>

        <!-- Quick nav cards -->
        <div class="col-md-4">
            <a asp-controller="Matches" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 text-center p-3">
                    <div class="card-body">
                        <i class="bi bi-trophy-fill text-warning" style="font-size:2.5rem"></i>
                        <h5 class="mt-3 mb-1">Matches</h5>
                        <p class="text-muted small">Create and manage matches, open the court view</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Teams" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 text-center p-3">
                    <div class="card-body">
                        <i class="bi bi-people-fill text-primary" style="font-size:2.5rem"></i>
                        <h5 class="mt-3 mb-1">Teams</h5>
                        <p class="text-muted small">Register teams and manage their information</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Players" asp-action="Index" class="text-decoration-none">
                <div class="card h-100 text-center p-3">
                    <div class="card-body">
                        <i class="bi bi-person-badge-fill text-success" style="font-size:2.5rem"></i>
                        <h5 class="mt-3 mb-1">Players</h5>
                        <p class="text-muted small">Add players, assign jersey numbers and teams</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Active Matches -->
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-activity me-2"></i>Active &amp; Recent Matches</span>
                    <a asp-controller="Matches" asp-action="Index" class="btn btn-sm btn-outline-light">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x" style="font-size:2rem"></i>
                            <p class="mt-2">No matches yet. <a asp-controller="Matches" asp-action="Create">Create one!</a></p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Reference</th>
                                        <th>Home Team</th>
                                        <th class="text-center">Score</th>
                                        <th>Away Team</th>
                                        <th class="text-center">Set</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model)
                                    {
                                        var currentSet = m.Sets.FirstOrDefault(s => s.SetNumber == m.CurrentSetNumber);
                                        <tr>
                                            <td><strong>@m.MatchReference</strong></td>
                                            <td>@m.HomeTeam?.Name</td>
                                            <td class="text-center fw-bold fs-5">
                                                @(currentSet?.HomeScore ?? 0) – @(currentSet?.AwayScore ?? 0)
                                            </td>
                                            <td>@m.AwayTeam?.Name</td>
                                            <td class="text-center">@m.CurrentSetNumber / @m.TotalSets</td>
                                            <td class="text-center">
                                                @{
                                                    var (badgeClass, statusText) = m.Status switch
                                                    {
                                                        MatchStatus.Setup => ("bg-secondary", "Setup"),
                                                        MatchStatus.InProgress => ("bg-success", "Live"),
                                                        MatchStatus.Completed => ("bg-dark", "Completed"),
                                                        _ => ("bg-secondary", "Unknown")
                                                    };
                                                }
                                                <span class="badge @badgeClass match-status-badge">@statusText</span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="Matches" asp-action="Court" asp-route-id="@m.Id"
                                                   class="btn btn-sm btn-primary">
                                                    <i class="bi bi-grid-3x3-gap me-1"></i>Court
                                                </a>
                                                <a asp-controller="Score" asp-action="Display" asp-route-id="@m.Id"
                                                   class="btn btn-sm btn-outline-dark" target="_blank">
                                                    <i class="bi bi-display me-1"></i>Display
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
